+/*
+ * Deliver the wakeups that did not arrive, and say so the first time and
+ * then rarely: a line per tick would bury everything else, and the number
+ * that matters is whether it is zero or not.
+ */
+void
+IOMobileFramebuffer::kickAction(OSObject *owner, IOTimerEventSource *sender)
+{
+	IOMobileFramebuffer *me = OSDynamicCast(IOMobileFramebuffer, owner);
+	unsigned int n;
+
+	if (me == NULL) {
+		return;
+	}
+	n = ipc_mqueue_kick_all();
+	if (n != 0) {
+		uint64_t before = me->fKicked;
+		me->fKicked += n;
+		if (before == 0 || (before / 500) != (me->fKicked / 500)) {
+			IOLog("iomfb: woke %u stalled port%s (%llu so far)\n",
+			    n, (n == 1) ? "" : "s",
+			    (unsigned long long)me->fKicked);
+		}
+	}
+	sender->setTimeoutMS(iomfb_kickms);
+}
