diff -ruN a/osfmk/ipc/ipc_mqueue.c b/osfmk/ipc/ipc_mqueue.c
--- a/osfmk/ipc/ipc_mqueue.c	2026-10-24 11:54:21.776011903 +0300
+++ b/osfmk/ipc/ipc_mqueue.c	2026-11-08 19:50:03.370302955 +0300
@@ -1837,3 +1837,132 @@
 	*mqueuep = mqueue;
 	return MACH_MSG_SUCCESS;
 }
+
+#include <kern/processor.h>     /* tasks, tasks_threads_lock */
+#include <ipc/ipc_entry.h>
+
+/*
+ *	Routine:	ipc_mqueue_has_watcher
+ *	Purpose:
+ *		Whether a kqueue is watching this port for arrivals.
+ *
+ *		A daemon that has checked in for a service and is waiting on a
+ *		dispatch queue is watching its port this way, and that is the
+ *		difference between "nobody is listening" and "somebody is
+ *		listening and was never told". A port with mail and a watcher
+ *		is the second: a wakeup that did not happen.
+ *	Conditions:
+ *		Nothing locked. Takes the port's queue lock.
+ */
+boolean_t ipc_mqueue_has_watcher(void *port_arg);
+
+boolean_t
+ipc_mqueue_has_watcher(void *port_arg)
+{
+	ipc_port_t   port = (ipc_port_t)port_arg;
+	ipc_mqueue_t mqueue;
+	boolean_t    watched;
+
+	if (port == IP_NULL) {
+		return FALSE;
+	}
+	mqueue = &port->ip_messages;
+
+	imq_lock(mqueue);
+	watched = (!imq_is_set(mqueue) && IMQ_KLIST_VALID(mqueue) &&
+	    !SLIST_EMPTY(&mqueue->imq_klist));
+	imq_unlock(mqueue);
+
+	return watched;
+}
+
+/*
+ *	Routine:	ipc_mqueue_kick_all
+ *	Purpose:
+ *		Re-fire the knote on every port that is holding mail and has a
+ *		watcher, across every task.
+ *
+ *		This is a workaround, and it is worth being plain about what it
+ *		works around. A message arriving on a port that a kqueue is
+ *		watching is supposed to wake that kqueue from ipc_mqueue_post,
+ *		which is where the KNOTE below is copied from, conditions and
+ *		all. On this port that wakeup is not reaching the daemons: lsd
+ *		sits in its run loop with three idle worker threads parked in
+ *		__workq_kernreturn and a message queued on one of its ports,
+ *		and the caller waits for a reply that is never going to be
+ *		composed. Every synchronous XPC call in the system is that
+ *		shape, because every XPC server takes its requests this way.
+ *
+ *		Until the lost wakeup itself is found, this delivers the
+ *		missing edge on a timer. It is wasteful and it is not a fix,
+ *		but a system that answers late answers, and one that never
+ *		wakes does not.
+ *	Conditions:
+ *		Nothing locked. Called from a timer on a workloop.
+ */
+unsigned int ipc_mqueue_kick_all(void);
+
+unsigned int
+ipc_mqueue_kick_all(void)
+{
+	task_t       task;
+	unsigned int kicked = 0;
+
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&tasks, task, task_t, tasks) {
+		ipc_space_t     space;
+		ipc_entry_num_t index;
+
+		if (task == kernel_task) {
+			continue;
+		}
+		space = task->itk_space;
+		if (space == IS_NULL) {
+			continue;
+		}
+
+		is_read_lock(space);
+		if (!is_active(space) || space->is_table == NULL) {
+			is_read_unlock(space);
+			continue;
+		}
+
+		for (index = 0; index < space->is_table_size; index++) {
+			ipc_entry_t  entry = &space->is_table[index];
+			ipc_port_t   port;
+			ipc_mqueue_t mqueue;
+
+			if ((entry->ie_bits & MACH_PORT_TYPE_RECEIVE) == 0) {
+				continue;
+			}
+			if (entry->ie_object == IO_NULL) {
+				continue;
+			}
+			/* Cast through void * so this needs no alignment pragma. */
+			port = (ipc_port_t)(void *) entry->ie_object;
+			mqueue = &port->ip_messages;
+
+			imq_lock(mqueue);
+			/*
+			 * The same conditions ipc_mqueue_post checks before it
+			 * wakes a knote, and nothing more: an active port with
+			 * a receiver, a usable klist, and somebody on it.
+			 */
+			if (!imq_is_set(mqueue) &&
+			    mqueue->imq_msgcount != 0 &&
+			    ip_active(port) &&
+			    port->ip_receiver_name != MACH_PORT_NULL &&
+			    is_active(port->ip_receiver) &&
+			    IMQ_KLIST_VALID(mqueue) &&
+			    !SLIST_EMPTY(&mqueue->imq_klist)) {
+				KNOTE(&mqueue->imq_klist, 0);
+				kicked++;
+			}
+			imq_unlock(mqueue);
+		}
+		is_read_unlock(space);
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+
+	return kicked;
+}
