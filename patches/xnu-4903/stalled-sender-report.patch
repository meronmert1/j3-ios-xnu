 /*
+ *	Routine:	ipc_mqueue_mail_info
+ *	Purpose:
+ *		Say who is waiting on the first message in a port's queue, and
+ *		how the port is being listened to.
+ *
+ *		"A port with mail and no knote" is two very different faults
+ *		depending on who sent the message. If it came from the process
+ *		that is blocked waiting for the answer, the receiver is simply
+ *		not listening where it should be. If it came from somewhere
+ *		else, the mail is unrelated and the blocked caller's message
+ *		went somewhere this report has not looked yet.
+ *
+ *		The sender's identity is already in the message: the trailer is
+ *		filled at copyin with the sending task's audit token, whose
+ *		sixth word is its pid. Reading it needs no bookkeeping of our
+ *		own, only the queue lock.
+ *
+ *		Membership of a port set matters too, because a port in a set
+ *		is received on through the set and carries no knote of its own.
+ *		Without that distinction an ordinary run-loop port looks
+ *		exactly like an abandoned one.
+ *	Conditions:
+ *		Nothing locked. Takes the port's queue lock.
+ */
+boolean_t ipc_mqueue_mail_info(void *port_arg, int *pid_out,
+    unsigned int *msgid_out, boolean_t *watched_out, boolean_t *in_set_out);
+
+boolean_t
+ipc_mqueue_mail_info(
+	void         *port_arg,
+	int          *pid_out,
+	unsigned int *msgid_out,
+	boolean_t    *watched_out,
+	boolean_t    *in_set_out)
+{
+	ipc_port_t   port = (ipc_port_t)port_arg;
+	ipc_mqueue_t mqueue;
+	ipc_kmsg_t   first;
+	boolean_t    got = FALSE;
+
+	*pid_out = -1;
+	*msgid_out = 0;
+	*watched_out = FALSE;
+	*in_set_out = FALSE;
+
+	if (port == IP_NULL) {
+		return FALSE;
+	}
+	mqueue = &port->ip_messages;
+
+	imq_lock(mqueue);
+	if (imq_is_set(mqueue)) {
+		imq_unlock(mqueue);
+		return FALSE;
+	}
+	*in_set_out = (port->ip_in_pset != 0);
+	*watched_out = (IMQ_KLIST_VALID(mqueue) &&
+	    !SLIST_EMPTY(&mqueue->imq_klist));
+
+	first = ipc_kmsg_queue_first(&mqueue->imq_messages);
+	if (first != IKM_NULL && first->ikm_header != MACH_MSG_HEADER_NULL) {
+		mach_msg_size_t size = first->ikm_header->msgh_size;
+
+		*msgid_out = (unsigned int)first->ikm_header->msgh_id;
+		/*
+		 * The trailer sits immediately after the rounded message, and
+		 * every kmsg is allocated with room for the largest one. Check
+		 * the size anyway: this runs on a queue that is already in a
+		 * state nobody designed for.
+		 */
+		if (size >= sizeof(mach_msg_header_t) &&
+		    round_msg(size) + sizeof(mach_msg_max_trailer_t) <=
+		    first->ikm_size) {
+			mach_msg_max_trailer_t *tr = (mach_msg_max_trailer_t *)
+			    ((vm_offset_t)first->ikm_header + round_msg(size));
+
+			*pid_out = (int)tr->msgh_audit.val[5];
+		}
+		got = TRUE;
+	}
+	imq_unlock(mqueue);
+
+	return got;
+}
