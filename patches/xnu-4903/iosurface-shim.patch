+void
+IOMobileFramebufferUserClient::tick(void)
+{
+	io_user_reference_t args[3];
+
+	fFrameSeq++;
+
+	/*
+	 * Frame info first, because that is the one the window server is
+	 * waiting on before it will set a mode. args[0] is the swap id the
+	 * framework reads as 64 bits, args[1] the count it reads as 32.
+	 */
+	args[0] = (io_user_reference_t)fFrameSeq;
+	args[1] = 0;
+	deliverNotify(kIOMFBNotifyFrameInfo, args, 2);
+
+	/*
+	 * Then vsync, which nothing arms until add_vsync_source has run, so
+	 * this is quiet until the chain above it has opened. Its three
+	 * arguments are times; there is no real vblank to timestamp, so the
+	 * clock that made this tick is the honest answer.
+	 */
+	args[0] = (io_user_reference_t)mach_absolute_time();
+	args[1] = args[0];
+	args[2] = (io_user_reference_t)fFrameSeq;
+	deliverNotify(kIOMFBNotifyVsync, args, 3);
+}
