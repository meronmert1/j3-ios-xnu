+#define super IOService
+OSDefineMetaClassAndStructors(IOCoreSurfaceRoot, IOService);
+
+bool
+IOCoreSurfaceRoot::start(IOService *provider)
+{
+	uint32_t on = 1;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+
+	if (PE_parse_boot_argn("iosurftrace", &on, sizeof(on))) {
+		iosurf_trace = (on != 0);
+	}
+
+	if (iosurf_lock == NULL) {
+		iosurf_lock = IOLockAlloc();
+		if (iosurf_lock == NULL) {
+			return false;
+		}
+	}
+
+	/*
+	 * The framework looks this up by name, not by class, so the name has
+	 * to be set rather than left to default.
+	 */
+	setName("IOCoreSurfaceRoot");
+	registerService();
+
+	IOLog("IOCoreSurfaceRoot: started\n");
+	return true;
+}
+
+IOReturn
+IOCoreSurfaceRoot::newUserClient(task_t owningTask, void *securityID,
+    UInt32 type, IOUserClient **handler)
+{
+	IOCoreSurfaceRootUserClient *client;
+
+	if (type != 0) {
+		IOLog("IOCoreSurfaceRoot: refused user client type %u\n",
+		    (unsigned)type);
+		return kIOReturnBadArgument;
+	}
+
+	client = new IOCoreSurfaceRootUserClient;
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type) ||
+	    !client->attach(this) || !client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnError;
+	}
+
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+#undef super
+#define super IOUserClient
+OSDefineMetaClassAndStructors(IOCoreSurfaceRootUserClient, IOUserClient);
+
+bool
+IOCoreSurfaceRootUserClient::initWithTask(task_t owningTask, void *securityID,
+    UInt32 type)
+{
+	int i;
+
+	if (!super::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+
+	fTask = owningTask;
+	fOwner = NULL;
+	fSerial = (uint32_t)OSIncrementAtomic(&iosurf_client_count) + 1;
+	for (i = 0; i < kIOSurfaceMaxMaps; i++) {
+		fMapID[i] = 0;
+		fMap[i] = NULL;
+	}
+
+	if (iosurf_trace) {
+		IOLog("IOCoreSurfaceRoot: [%u] opened by pid %d\n",
+		    fSerial, proc_selfpid());
+	}
+	return true;
+}
+
+bool
+IOCoreSurfaceRootUserClient::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	fOwner = OSDynamicCast(IOCoreSurfaceRoot, provider);
+	return fOwner != NULL;
+}
+
+void
+IOCoreSurfaceRootUserClient::free(void)
+{
+	int i;
+
+	for (i = 0; i < kIOSurfaceMaxMaps; i++) {
+		if (fMap[i] != NULL) {
+			fMap[i]->release();
+			fMap[i] = NULL;
+			fMapID[i] = 0;
+		}
+	}
+	super::free();
+}
+
+IOReturn
+IOCoreSurfaceRootUserClient::clientClose(void)
+{
+	if (iosurf_trace) {
+		IOLog("IOCoreSurfaceRoot: [%u] closed\n", fSerial);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOCoreSurfaceRootUserClient::clientDied(void)
+{
+	if (iosurf_trace) {
+		IOLog("IOCoreSurfaceRoot: [%u] client died\n", fSerial);
+	}
+	return super::clientDied();
+}
+
+/*
+ * The mapping this client has of a surface, made on first use. Returned
+ * without a reference: the client holds the only one and drops it in free.
+ */
+IOMemoryMap *
+IOCoreSurfaceRootUserClient::mapFor(struct iosurface_rec *rec)
+{
+	IOMemoryMap *map;
+	int i, slot = -1;
+
+	for (i = 0; i < kIOSurfaceMaxMaps; i++) {
+		if (fMap[i] != NULL && fMapID[i] == rec->id) {
+			return fMap[i];
+		}
+		if (fMap[i] == NULL && slot < 0) {
+			slot = i;
+		}
+	}
+	if (slot < 0) {
+		return NULL;
+	}
+
+	map = rec->md->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		return NULL;
+	}
+
+	fMap[slot] = map;
+	fMapID[slot] = rec->id;
+	return map;
+}
+
+IOReturn
+IOCoreSurfaceRootUserClient::fillInfo(struct iosurface_rec *rec, void *out,
+    mach_vm_address_t addr)
+{
+	uint8_t *p = (uint8_t *)out;
+
+	bzero(p, kIOSurfaceInfoSize);
+
+	*(uint64_t *)(p + kIOSurfaceInfoBase)  = (uint64_t)addr;
+	*(uint64_t *)(p + kIOSurfaceInfoState) = (uint64_t)addr;
+	*(uint32_t *)(p + kIOSurfaceInfoID)    = rec->id;
+	*(uint32_t *)(p + kIOSurfaceInfoAllocSize) = rec->pixelBytes;
+	*(uint32_t *)(p + kIOSurfaceInfoWidth)  = rec->width;
+	*(uint32_t *)(p + kIOSurfaceInfoHeight) = rec->height;
+	*(uint32_t *)(p + kIOSurfaceInfoStride) = rec->stride;
+	*(uint32_t *)(p + kIOSurfaceInfoPlaneOff) = (uint32_t)PAGE_SIZE;
+	*(uint32_t *)(p + kIOSurfaceInfoFormat) = rec->format;
+	*(uint32_t *)(p + kIOSurfaceInfoPlanes) = 0;
+	*(uint16_t *)(p + kIOSurfaceInfoBPE)   = 4;
+	p[kIOSurfaceInfoElemW] = 1;
+	p[kIOSurfaceInfoElemH] = 1;
+
+	return kIOReturnSuccess;
+}
+
+/* A uint32 out of the serialized property dictionary, or a default. */
+static uint32_t
+iosurf_number(OSDictionary *props, const char *key, uint32_t dflt)
+{
+	OSNumber *n;
+
+	if (props == NULL) {
+		return dflt;
+	}
+	n = OSDynamicCast(OSNumber, props->getObject(key));
+	if (n == NULL) {
+		return dflt;
+	}
+	return n->unsigned32BitValue();
+}
+
+IOReturn
+IOCoreSurfaceRootUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch,
+    OSObject *target, void *reference)
+{
+	IOReturn ret = kIOReturnUnsupported;
+
+	switch (selector) {
+	case kIOSurfaceCreate: {
+		OSObject             *obj = NULL;
+		OSDictionary         *props = NULL;
+		struct iosurface_rec *rec = NULL;
+		IOBufferMemoryDescriptor *md;
+		IOMemoryMap          *map;
+		uint32_t              w, h, stride, format, bytes, total;
+		int                   i, slot = -1;
+
+		if (arguments->structureOutputSize < kIOSurfaceInfoSize) {
+			return kIOReturnBadArgument;
+		}
+
+		if (arguments->structureInput != NULL &&
+		    arguments->structureInputSize > 0) {
+			obj = OSUnserializeXML(
+				(const char *)arguments->structureInput,
+				arguments->structureInputSize, NULL);
+			props = OSDynamicCast(OSDictionary, obj);
+		}
+
+		w = iosurf_number(props, "IOSurfaceWidth", 0);
+		h = iosurf_number(props, "IOSurfaceHeight", 0);
+		stride = iosurf_number(props, "IOSurfaceBytesPerRow", 0);
+		format = iosurf_number(props, "IOSurfacePixelFormat", 0);
+
+		/*
+		 * A caller that gives a size but no stride means the obvious
+		 * one; a caller that gives neither is asking for something
+		 * this file cannot invent.
+		 */
+		if (stride == 0) {
+			stride = w * 4;
+		}
+		if (w == 0 || h == 0 || stride == 0) {
+			if (obj != NULL) {
+				obj->release();
+			}
+			IOLog("IOCoreSurfaceRoot: [%u] create without a size\n",
+			    fSerial);
+			return kIOReturnBadArgument;
+		}
+
+		bytes = iosurf_number(props, "IOSurfaceAllocSize", stride * h);
+		if (bytes < stride * h) {
+			bytes = stride * h;
+		}
+		total = (uint32_t)(PAGE_SIZE + round_page(bytes));
+
+		md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+			kIODirectionInOut | kIOMemoryKernelUserShared,
+			total, PAGE_SIZE);
+		if (md == NULL) {
+			if (obj != NULL) {
+				obj->release();
+			}
+			return kIOReturnNoMemory;
+		}
+		bzero(md->getBytesNoCopy(), total);
+
+		IOLockLock(iosurf_lock);
+		for (i = 0; i < kIOSurfaceMaxSurfaces; i++) {
+			if (iosurf_table[i].md == NULL) {
+				slot = i;
+				break;
+			}
+		}
+		if (slot >= 0) {
+			rec = &iosurf_table[slot];
+			rec->id = iosurf_next_id++;
+			rec->width = w;
+			rec->height = h;
+			rec->stride = stride;
+			rec->format = format;
+			rec->pixelBytes = bytes;
+			rec->md = md;
+		}
+		IOLockUnlock(iosurf_lock);
+
+		if (obj != NULL) {
+			obj->release();
+		}
+		if (rec == NULL) {
+			md->release();
+			IOLog("IOCoreSurfaceRoot: [%u] out of surface slots\n",
+			    fSerial);
+			return kIOReturnNoResources;
+		}
+
+		map = mapFor(rec);
+		if (map == NULL) {
+			IOLockLock(iosurf_lock);
+			rec->md = NULL;
+			IOLockUnlock(iosurf_lock);
+			md->release();
+			return kIOReturnNoMemory;
+		}
+
+		fillInfo(rec, arguments->structureOutput, map->getAddress());
+		arguments->structureOutputSize = kIOSurfaceInfoSize;
+
+		if (iosurf_trace) {
+			IOLog("IOCoreSurfaceRoot: [%u] created id %u "
+			    "%ux%u stride %u fmt 0x%x at 0x%llx\n",
+			    fSerial, rec->id, w, h, stride, format,
+			    (unsigned long long)map->getAddress());
+		}
+		return kIOReturnSuccess;
+	}
+
+	case kIOSurfaceLookup: {
+		struct iosurface_rec *rec;
+		IOMemoryMap *map;
+		uint32_t id;
+
+		if (arguments->scalarInputCount < 1 ||
+		    arguments->structureOutputSize < kIOSurfaceInfoSize) {
+			return kIOReturnBadArgument;
+		}
+		id = (uint32_t)arguments->scalarInput[0];
+
+		IOLockLock(iosurf_lock);
+		rec = iosurf_find(id);
+		IOLockUnlock(iosurf_lock);
+		if (rec == NULL) {
+			if (iosurf_trace) {
+				IOLog("IOCoreSurfaceRoot: [%u] lookup of "
+				    "unknown id %u\n", fSerial, id);
+			}
+			return kIOReturnNotFound;
+		}
+
+		map = mapFor(rec);
+		if (map == NULL) {
+			return kIOReturnNoMemory;
+		}
+
+		fillInfo(rec, arguments->structureOutput, map->getAddress());
+		arguments->structureOutputSize = kIOSurfaceInfoSize;
+
+		if (iosurf_trace) {
+			IOLog("IOCoreSurfaceRoot: [%u] looked up id %u\n",
+			    fSerial, id);
+		}
+		return kIOReturnSuccess;
+	}
+
+	case kIOSurfaceRelease: {
+		struct iosurface_rec *rec;
+		IOBufferMemoryDescriptor *md = NULL;
+		uint32_t id;
+		int i;
+
+		if (arguments->scalarInputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		id = (uint32_t)arguments->scalarInput[0];
+
+		for (i = 0; i < kIOSurfaceMaxMaps; i++) {
+			if (fMap[i] != NULL && fMapID[i] == id) {
+				fMap[i]->release();
+				fMap[i] = NULL;
+				fMapID[i] = 0;
+			}
+		}
+
+		IOLockLock(iosurf_lock);
+		rec = iosurf_find(id);
+		if (rec != NULL) {
+			md = rec->md;
+			rec->md = NULL;
+		}
+		IOLockUnlock(iosurf_lock);
+
+		if (md != NULL) {
+			md->release();
+		}
+		if (iosurf_trace) {
+			IOLog("IOCoreSurfaceRoot: [%u] released id %u%s\n",
+			    fSerial, id, md ? "" : " (unknown)");
+		}
+		return kIOReturnSuccess;
+	}
+
+	case kIOSurfaceLock:
+	case kIOSurfaceUnlock:
+		/*
+		 * Nothing here moves a surface or changes its caching, so
+		 * there is nothing to do between a lock and an unlock. The
+		 * call still has to succeed: the framework treats a failure
+		 * as the surface being gone.
+		 */
+		if (arguments->structureOutput != NULL &&
+		    arguments->structureOutputSize > 0) {
+			bzero(arguments->structureOutput,
+			    arguments->structureOutputSize);
+		}
+		return kIOReturnSuccess;
+
+	default:
+		/*
+		 * The same rule the display shim settled on: a selector that
+		 * asks for nothing back is accepted and dropped, one that
+		 * wants an answer is refused so that the refusal stops where
+		 * it happens.
+		 */
+		if (arguments->scalarOutputCount == 0 &&
+		    arguments->structureOutputSize == 0) {
+			if (iosurf_trace) {
+				IOLog("IOCoreSurfaceRoot: [%u] selector %u "
+				    "accepted and dropped\n",
+				    fSerial, selector);
+			}
+			return kIOReturnSuccess;
+		}
+		IOLog("IOCoreSurfaceRoot: [%u] unimplemented selector %u "
+		    "(in %u scalars/%u bytes, out %u scalars/%u bytes)\n",
+		    fSerial, selector,
+		    (unsigned)arguments->scalarInputCount,
+		    (unsigned)arguments->structureInputSize,
+		    (unsigned)arguments->scalarOutputCount,
+		    (unsigned)arguments->structureOutputSize);
+		break;
+	}
+
+	return ret;
+}
