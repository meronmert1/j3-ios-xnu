+/*
+ * Send one notification to whoever armed that type.
+ *
+ * IOConnectSetNotificationPort left the port here and selector 72 left the
+ * callback and the context, which is exactly the three things an async
+ * reference is built out of. setAsyncReference64 and sendAsyncResult64 are
+ * protected statics on IOUserClient, so a subclass may call them; what
+ * arrives on the other side is the framework's NotifyCallbackFuncs entry
+ * for the type, called as (refcon, result, args, numArgs).
+ */
+void
+IOMobileFramebufferUserClient::deliverNotify(uint32_t type,
+    io_user_reference_t *args, uint32_t numArgs)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= kIOMFBNotifyTypes ||
+	    fNotifyPort[type] == MACH_PORT_NULL ||
+	    fNotifyCallback[type] == 0) {
+		return;
+	}
+
+	bzero(ref, sizeof(ref));
+
+	/*
+	 * The task matters. The four argument form of this leaves
+	 * kIOUCAsync64Flag clear, and sendAsyncResult64 then takes its msg32
+	 * branch and REF32s every slot of the reference on the way out. A
+	 * 64-bit caller reads that back as the 64-bit layout, so the whole
+	 * array shifts by half a slot and it calls the low half of the refcon
+	 * as the function. That is a jump to a number, and it is exactly what
+	 * backboardd did: refcon 0x154014A00, pc 0x54014A00. The five
+	 * argument form sets the flag when the task's map is 64-bit.
+	 */
+	IOUserClient::setAsyncReference64(ref, fNotifyPort[type],
+	    (mach_vm_address_t)fNotifyCallback[type],
+	    (io_user_reference_t)fNotifyContext[type], fTask);
+
+	sendAsyncResult64(ref, kIOReturnSuccess, args, numArgs);
+}
