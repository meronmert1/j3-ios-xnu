+/*
+ * Bring-up: where a process that is not dying is stuck.
+ *
+ * exitbt prints the backtrace of a thread that has just taken a signal,
+ * which answers why a process died. It says nothing about one that is
+ * alive and idle, and that is the state the window server and SpringBoard
+ * are both in on this handset: present in every roll call, never crashing,
+ * never drawing. Whatever is holding them is a wait, not a fault, and a
+ * wait leaves no corpse to read.
+ *
+ * A blocked thread has its user state saved in exactly the same place a
+ * dying one does, so the same frame walk works, with one difference: the
+ * stack belongs to another task, so the copyin has to run with that task's
+ * map installed. backtrace_thread_user() already does that -- it switches
+ * the map, walks the chain and switches back -- so all this adds is the
+ * loop over the process's threads and a line each.
+ *
+ * The threads are collected under the proc lock and referenced before the
+ * lock is dropped, because the walk can fault and must not hold it, and a
+ * libdispatch worker that retires in between would otherwise be walked
+ * after it was freed.
+ *
+ * As with exitbt these are addresses and not symbols: nothing here knows
+ * where any of it was loaded. That is enough, because the distance between
+ * two frames inside one image survives the slide, which is what names the
+ * call site.
+ */
+#define PROC_BT_FRAMES          10
+#define PROC_BT_MAX_THREADS     12
+
+void
+proc_user_backtrace(int pid)
+{
+	thread_t threads[PROC_BT_MAX_THREADS];
+	uintptr_t bt[PROC_BT_FRAMES];
+	char line[256];
+	struct uthread *uth;
+	thread_t th;
+	proc_t p;
+	uint32_t frames;
+	bool user_64;
+	size_t off;
+	int count = 0;
+	int i, j, wrote;
+
+	if ((p = proc_find(pid)) == PROC_NULL) {
+		return;
+	}
+
+	proc_lock(p);
+	TAILQ_FOREACH(uth, &p->p_uthlist, uu_list) {
+		th = uth->uu_context.vc_thread;
+
+		if (count >= PROC_BT_MAX_THREADS) {
+			break;
+		}
+		if (th == THREAD_NULL) {
+			continue;
+		}
+		thread_reference(th);
+		threads[count++] = th;
+	}
+	proc_unlock(p);
+
+	printf("bt: %s[%d] %d thread(s)\n", &p->p_comm[0], pid, count);
+
+	for (i = 0; i < count; i++) {
+		/*
+		 * A non-zero return still leaves behind whatever frames it
+		 * did manage -- a stack that stops being walkable half way
+		 * up is the normal case, not a failure -- so the count is
+		 * what is read, not the status.
+		 */
+		frames = 0;
+		user_64 = false;
+		(void)backtrace_thread_user(threads[i], bt, PROC_BT_FRAMES,
+		    &frames, &user_64);
+
+		if (frames == 0) {
+			printf("  t%-2d (no user state)\n", i);
+			thread_deallocate(threads[i]);
+			continue;
+		}
+
+		wrote = snprintf(line, sizeof(line), "  t%-2d", i);
+		off = (wrote > 0) ? (size_t)wrote : 0;
+		for (j = 0; j < (int)frames; j++) {
+			wrote = snprintf(line + off, sizeof(line) - off,
+			    " 0x%llx", (unsigned long long)bt[j]);
+			if (wrote < 0 || (size_t)wrote >= sizeof(line) - off) {
+				break;
+			}
+			off += (size_t)wrote;
+		}
+		printf("%s\n", line);
+
+		thread_deallocate(threads[i]);
+	}
+
+	proc_rele(p);
+}
