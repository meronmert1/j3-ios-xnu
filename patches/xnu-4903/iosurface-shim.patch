+	IOUserClient::setAsyncReference64(ref, fNotifyPort[type],
+	    (mach_vm_address_t)fNotifyCallback[type],
+	    (io_user_reference_t)fNotifyContext[type], fTask);
+
+	sendAsyncResult64(ref, kIOReturnSuccess, args, numArgs);
+}
+
+void
+IOMobileFramebufferUserClient::tick(void)
+{
+	io_user_reference_t args[3];
+
+	fFrameSeq++;
+
+	/*
+	 * Frame info first, because that is the one the window server is
+	 * waiting on before it will set a mode. args[0] is the swap id the
+	 * framework reads as 64 bits, args[1] the count it reads as 32.
+	 */
+	args[0] = (io_user_reference_t)fFrameSeq;
+	args[1] = 0;
+	deliverNotify(kIOMFBNotifyFrameInfo, args, 2);
+
+	/*
+	 * Then vsync, which nothing arms until add_vsync_source has run, so
+	 * this is quiet until the chain above it has opened. Its three
+	 * arguments are times; there is no real vblank to timestamp, so the
+	 * clock that made this tick is the honest answer.
+	 */
+	args[0] = (io_user_reference_t)mach_absolute_time();
+	args[1] = args[0];
+	args[2] = (io_user_reference_t)fFrameSeq;
+	deliverNotify(kIOMFBNotifyVsync, args, 3);
+}
+
+void
+IOMobileFramebufferUserClient::tickAction(OSObject *owner,
+    IOTimerEventSource *sender)
+{
+	IOMobileFramebufferUserClient *me =
+	    OSDynamicCast(IOMobileFramebufferUserClient, owner);
+
+	if (me == NULL) {
+		return;
+	}
+	me->tick();
+	if (iomfb_tick_hz != 0) {
+		sender->setTimeoutMS(1000 / iomfb_tick_hz);
+	}
+}
+
+void
+IOMobileFramebufferUserClient::startTicking(void)
+{
+	if (fTick != NULL || iomfb_tick_hz == 0) {
+		return;
+	}
+
+	fTickLoop = IOWorkLoop::workLoop();
+	if (fTickLoop == NULL) {
+		return;
+	}
+	fTick = IOTimerEventSource::timerEventSource(this, &tickAction);
+	if (fTick == NULL ||
+	    fTickLoop->addEventSource(fTick) != kIOReturnSuccess) {
+		if (fTick != NULL) {
+			fTick->release();
+			fTick = NULL;
+		}
+		fTickLoop->release();
+		fTickLoop = NULL;
+		return;
+	}
+
+	IOLog("IOMobileFramebuffer: [%u] frame clock started at %u Hz\n",
+	    (unsigned)fSerial, (unsigned)iomfb_tick_hz);
+	fTick->setTimeoutMS(1000 / iomfb_tick_hz);
+}
+
+void
+IOMobileFramebufferUserClient::stopTicking(void)
+{
+	if (fTick != NULL) {
+		fTick->cancelTimeout();
+		if (fTickLoop != NULL) {
+			fTickLoop->removeEventSource(fTick);
+		}
+		fTick->release();
+		fTick = NULL;
+	}
+	if (fTickLoop != NULL) {
+		fTickLoop->release();
+		fTickLoop = NULL;
+	}
+}
+
