+++ b/osfmk/kern/startup.c
@@ -156,6 +156,7 @@
 #if CONFIG_VNGUARD
 extern void vnguard_policy_init(void);
 #endif
+extern void amfi_stub_policy_init(void);
 #endif
 
 #if KPC
@@ -632,6 +633,13 @@
 #if CONFIG_VNGUARD
 	vnguard_policy_init();
 #endif
+	/*
+	 * dyld will not start without a policy registered under the name
+	 * "AMFI"; see security/mac_base.c. Registered beside vnguard because
+	 * this is where MAC policies that live in the kernel come up, and long
+	 * before bsd_init() reaches an init program.
+	 */
+	amfi_stub_policy_init();
 #endif
 
 #if CONFIG_DTRACE
--- a/security/mac_base.c
+++ b/security/mac_base.c
@@ -1853,6 +1853,290 @@
 	return error;
 }
 
+/*
+ * The two headers below are included again here rather than at the top of the
+ * file: that copy of section_keywords.h sits inside #if CONFIG_EMBEDDED, and
+ * what follows should not depend on which configuration this is. Both have
+ * include guards.
+ */
+#include <pexpert/pexpert.h>
+#include <libkern/section_keywords.h>
+#include <kern/cs_blobs.h>
+#include <sys/codesign.h>
+
+/*
+ * A minimal AMFI, so that dyld can start.
+ *
+ * dyld calls amfi_check_dyld_policy_self() before it does anything else, and
+ * treats a failure as fatal:
+ *
+ *     amfi_check_dyld_policy_self() failed
+ *
+ * which is where this kernel's boot ended once launchd was on the RAM disk.
+ * That function is __mac_syscall("AMFI", 0x5a, &args), and __mac_syscall
+ * returns ENOPOLICY when no registered policy carries that name. On a real
+ * device the name belongs to AppleMobileFileIntegrity, a kext; this kernel
+ * has none, so the call could never succeed.
+ *
+ * The argument block and the call number are read out of dyld itself rather
+ * than guessed:
+ *
+ *     _amfi_check_dyld_policy_self:
+ *         str  xzr, [x1]              ; *output_flags = 0
+ *         add  x8, sp, #8             ; an uninitialised local
+ *         stp  x0, x8, [sp, #0x10]    ; { input_flags, &local }
+ *         add  x0, x0, #0x647         ; "AMFI"
+ *         mov  w1, #0x5a
+ *         add  x2, sp, #0x10
+ *         bl   ___mac_syscall
+ *         cbz  w0, ...                ; on success, *output_flags = local
+ *
+ * Note the local at sp+8 is never initialised before the call. A policy that
+ * returned success without writing to it would hand dyld whatever was on its
+ * stack and call it a set of permissions, so this writes the answer every
+ * time it reports success.
+ *
+ * The answer is zero by default, which is what AMFI gives an ordinary
+ * platform binary: every bit in this word grants a relaxation -- honouring
+ * @executable_path, DYLD_ environment variables, fallback paths, a custom
+ * shared cache -- and refusing all of them is both the restrictive choice and
+ * the usual one. dyld says so itself:
+ *
+ *     dyld: warning: @executable_path/ ignored because of amfi policy
+ *
+ * amfi_dyld_flags= sets it otherwise, for when something turns out to need a
+ * relaxation; the bit assignments belong to AMFI and are not documented here
+ * because this kernel has no way to check a guess about them.
+ *
+ * This is not AMFI. It answers one question and implements no part of what
+ * the name stands for: nothing here validates a signature, an entitlement or
+ * a provisioning profile. It exists so that dyld can get past a call that
+ * cannot otherwise be answered, on a kernel that has no code signing to
+ * enforce in the first place.
+ */
+#define AMFI_POLICY_NAME                "AMFI"
+#define AMFI_DYLD_POLICY_SELF           0x5a
+
+struct amfi_dyld_policy_args {
+	uint64_t        input_flags;
+	uint64_t        output_flags;   /* a user address to write the answer to */
+};
+
+static uint64_t amfi_dyld_flags = 0;
+
+/*
+ * amfi_debug=1 traces what this policy is asked and what it answers.
+ *
+ * It is deliberately a boot-arg of its own rather than a use of cs_debug.
+ * cs_debug is what would otherwise carry these traces, but cs_debug > 1 also
+ * turns on cs_validate_page()'s per-page report, and on this kernel every
+ * page fails to validate -- the SHA that would hash it returns zeros without
+ * corecrypto -- so the console fills with
+ *
+ *     cs_validate_page: ... actual [0x0 0x0 0x0 0x0 0x0] != expected [...]
+ *
+ * faster than it can be read. A separate flag keeps the answers legible
+ * while that remains true.
+ */
+static int amfi_debug = 0;
+
+static int
+amfi_stub_policy_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	struct amfi_dyld_policy_args args;
+	uint64_t answer;
+	int error;
+
+	if (call != AMFI_DYLD_POLICY_SELF) {
+		return ENOTSUP;
+	}
+
+	/*
+	 * The argument block is two 64-bit words whatever the caller is, and
+	 * every process on this machine is 64-bit. A 32-bit caller would lay
+	 * it out differently, so it is refused rather than misread.
+	 */
+	if (!proc_is64bit(p)) {
+		return ENOTSUP;
+	}
+
+	error = copyin(arg, &args, sizeof(args));
+	if (error) {
+		return error;
+	}
+	if (args.output_flags == 0) {
+		return EINVAL;
+	}
+
+	answer = amfi_dyld_flags;
+	return copyout(&answer, (user_addr_t)args.output_flags, sizeof(answer));
+}
+
+/*
+ * The second thing AMFI does that this kernel misses: mark Apple's own
+ * binaries as platform binaries.
+ *
+ * With launchd running and a daemon to start, the boot ended here instead:
+ *
+ *     initproc exited -- exit reason namespace 7 subcode 0x1 description:
+ *     unexpected exec of non-platform binary: /usr/sbin/syslogd
+ *
+ * launchd had already spawned /usr/libexec/xpcproxy, which had exec'd
+ * syslogd; what it refused was the result. A daemon out of a system
+ * LaunchDaemons plist is required to be a platform binary, and launchd calls
+ * its own assertion fatal when one is not.
+ *
+ * Nothing in this kernel can make that true. ubc_cs_blob_add() decides it
+ * from one bit:
+ *
+ *     if (blob->csb_flags & CS_PLATFORM_BINARY) {
+ *             blob->csb_platform_binary = 1;
+ *
+ * and the only thing that can put that bit there is the policy hook a few
+ * lines above, which is handed the flags by reference precisely so a policy
+ * can add to them:
+ *
+ *     unsigned int cs_flags = blob->csb_flags;
+ *     error = mac_vnode_check_signature(vp, blob, imgp, &cs_flags, ...);
+ *     blob->csb_flags = cs_flags;
+ *
+ * That hook is AMFI's on a device, where the answer comes from the signature:
+ * Apple's own code is platform code and nothing else is. Here it is answered
+ * yes for everything, which sounds worse than it is -- this kernel cannot
+ * tell one signature from another in the first place, because the SHA that
+ * would distinguish them returns zeros without corecrypto. The distinction
+ * does not exist yet, so nothing is being given away by not drawing it.
+ *
+ * amfi_platform_binary=0 turns it off, which is useful for finding out
+ * whether something depends on it.
+ *
+ * CS_PLATFORM_PATH is cleared rather than left alone: it means "platform by
+ * virtue of where it sits on disk", it is macOS-only, and claiming it here
+ * would be a second claim this kernel cannot support.
+ */
+static int amfi_platform_binary = 1;
+
+static int
+amfi_stub_vnode_check_signature(struct vnode *vp,
+    struct label *label __unused,
+    cpu_type_t cpu_type __unused,
+    struct cs_blob *cs_blob __unused,
+    unsigned int *cs_flags,
+    unsigned int *signer_type,
+    int flags __unused,
+    char **fatal_failure_desc __unused,
+    size_t *fatal_failure_desc_len __unused)
+{
+	unsigned int before = (cs_flags != NULL) ? *cs_flags : 0;
+
+	if (amfi_platform_binary && cs_flags != NULL) {
+		*cs_flags |= CS_PLATFORM_BINARY;
+		*cs_flags &= ~CS_PLATFORM_PATH;
+	}
+	if (signer_type != NULL) {
+		*signer_type = CS_SIGNER_TYPE_UNKNOWN;
+	}
+
+	if (amfi_debug) {
+		printf("amfi: signature of %s: cs_flags 0x%x -> 0x%x\n",
+		    (vp != NULL && vp->v_name != NULL) ? vp->v_name : "?",
+		    before, (cs_flags != NULL) ? *cs_flags : 0);
+	}
+
+	/*
+	 * fatal_failure_desc is left alone. mac_vnode_check_signature() reads
+	 * a non-zero length as "the signature failed fatally" and panics if
+	 * that is claimed alongside a zero return.
+	 */
+	return 0;
+}
+
+/*
+ * Not an access control check: a trace of the one question launchd asks.
+ *
+ * launchd kills the boot when a daemon it started turns out not to be a
+ * platform binary, and it finds that out by asking the kernel. The call and
+ * the bit are its own code, read out of launchd rather than guessed:
+ *
+ *     mov  w1, #0                      ; ops = CS_OPS_STATUS
+ *     bl   _csops_audittoken
+ *     cbz  w0, 0x1000205ec             ; on success ->
+ *     ...
+ *     adr  x2, "csops returned %d"     ; on failure, logged and then fatal
+ *     ...
+ *   0x1000205ec:
+ *     ldur w8, [fp, #-0x24]            ; the status word csops wrote
+ *     tbnz w8, #0x1a, <return>         ; bit 26 set -> accepted
+ *     ...                              ; clear -> "unexpected exec of
+ *                                      ;   non-platform binary: %s"
+ *
+ * Bit 26 is CS_PLATFORM_BINARY, which csops(CS_OPS_STATUS) ORs in from
+ * csproc_get_platform_binary() -- the blob on the process's text vnode, the
+ * same blob the hook above writes to. So the two ends of that chain are
+ * known; what is not known is whether it joins up, and this prints the
+ * kernel's answer at the moment launchd asks for it.
+ *
+ * csops_internal() calls this before it takes proc_lock, so reading the blob
+ * here is safe. Returning 0 is also the right answer in its own right:
+ * nothing about this kernel justifies refusing a process its own code
+ * signing status.
+ */
+static int
+amfi_stub_proc_check_get_cs_info(kauth_cred_t cred __unused,
+    struct proc *target, unsigned int op)
+{
+	if (amfi_debug && target != NULL) {
+		printf("amfi: pid %d asked csops(%u) about pid %d[%s]: "
+		    "platform=%d\n", proc_selfpid(), op, target->p_pid,
+		    target->p_comm, csproc_get_platform_binary(target));
+	}
+	return 0;
+}
+
+static struct mac_policy_ops amfi_stub_policy_ops = {
+	.mpo_policy_syscall = amfi_stub_policy_syscall,
+	.mpo_vnode_check_signature = amfi_stub_vnode_check_signature,
+	.mpo_proc_check_get_cs_info = amfi_stub_proc_check_get_cs_info,
+};
+
+SECURITY_READ_ONLY_LATE(static struct mac_policy_conf) amfi_stub_policy_conf = {
+	.mpc_name               = AMFI_POLICY_NAME,
+	.mpc_fullname           = "Minimal AMFI (dyld policy only)",
+	.mpc_field_off          = NULL,         /* no labels, so no slot */
+	.mpc_labelnames         = NULL,
+	.mpc_labelname_count    = 0,
+	.mpc_ops                = &amfi_stub_policy_ops,
+	.mpc_loadtime_flags     = 0,
+	.mpc_runtime_flags      = 0,
+};
+
+static mac_policy_handle_t amfi_stub_policy_handle;
+
+void amfi_stub_policy_init(void);
+void
+amfi_stub_policy_init(void)
+{
+	int error;
+
+	PE_parse_boot_argn("amfi_dyld_flags", &amfi_dyld_flags,
+	    sizeof(amfi_dyld_flags));
+	PE_parse_boot_argn("amfi_platform_binary", &amfi_platform_binary,
+	    sizeof(amfi_platform_binary));
+	PE_parse_boot_argn("amfi_debug", &amfi_debug, sizeof(amfi_debug));
+
+	/*
+	 * Reported rather than ignored. A failure here is silent otherwise:
+	 * the boot carries on and dies much later in dyld, with nothing on
+	 * the console to connect the two.
+	 */
+	error = mac_policy_register(&amfi_stub_policy_conf,
+	    &amfi_stub_policy_handle, NULL);
+	if (error != 0) {
+		printf("amfi: mac_policy_register failed: %d -- dyld will not "
+		    "start\n", error);
+	}
+}
+
 int
 mac_mount_label_get(struct mount *mp, user_addr_t mac_p)
 {
