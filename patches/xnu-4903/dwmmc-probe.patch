+/*
+ * Declared here rather than included. No file under bsd/ includes
+ * <arm/machine_routines.h>, and this should not be the first: bsd/kern/
+ * kern_exit.c declares delay() the same way, which is the house pattern for
+ * reaching an osfmk routine from BSD.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void delay(int usec);
+
+/* Register offsets, from the controller. */
+#define DWMMC_CTRL              0x000
+#define DWMMC_PWREN             0x004
+#define DWMMC_CLKDIV            0x008
+#define DWMMC_CLKSRC            0x00c
+#define DWMMC_CLKENA            0x010
+#define DWMMC_TMOUT             0x014
+#define DWMMC_CTYPE             0x018
+#define DWMMC_BLKSIZ            0x01c
+#define DWMMC_BYTCNT            0x020
+#define DWMMC_INTMASK           0x024
+#define DWMMC_CMDARG            0x028
+#define DWMMC_CMD               0x02c
+#define DWMMC_RESP0             0x030
+#define DWMMC_RESP1             0x034
+#define DWMMC_RESP2             0x038
+#define DWMMC_RESP3             0x03c
+#define DWMMC_MINTSTS           0x040
+#define DWMMC_RINTSTS           0x044
+#define DWMMC_STATUS            0x048
+#define DWMMC_FIFOTH            0x04c
+#define DWMMC_CDETECT           0x050
+#define DWMMC_WRTPRT            0x054
+#define DWMMC_USRID             0x068
+#define DWMMC_VERID             0x06c
+#define DWMMC_HCON              0x070
+#define DWMMC_UHS_REG           0x074
+
+/*
+ * Samsung's own register, not part of the DesignWare layout. It carries the
+ * sample and drive phase of the card clock and a further divider. Zero is
+ * the reset value and is what the identification clock wants; a card that
+ * answers CMD0 but fails later at speed is the symptom of needing something
+ * else here, which is why it is a boot argument.
+ */
+#define DWMMC_CLKSEL            0x09c
+#define DWMMC_BMOD              0x080
+
+/*
+ * The FIFO. 0x200 is where it sits on this IP revision; the older cores,
+ * before 0x240A, put it at 0x100.
+ *
+ * Reading it is where two attempts went wrong, so it is worth writing down.
+ * This core's FIFO is 64 bits wide (see DWMMC_HCON_DATA_WIDTH), and a 64-bit
+ * access to it is not allowed -- the entry is consumed by reading the low
+ * half at DWMMC_DATA and then the high half at DWMMC_DATA + 4. Reading only
+ * the low half leaves the entry in place, and so does a single 64-bit load:
+ * either way the same word comes back forever and the FIFO never empties.
+ *
+ * This is not peculiar to this board. Linux carries DW_MMC_QUIRK_FIFO64_32
+ * for exactly it, and the hardware its commit message names is Exynos7870 --
+ * the sibling of the Exynos7570 here, same generation, same core.
+ */
+#define DWMMC_DATA              0x200
+
+/* One 4 KiB page covers the whole block; the device tree asks for 0x2000. */
+#define DWMMC_REGS_SIZE         0x2000
+
+/*
+ * The pin controllers.
+ *
+ * A DesignWare controller with a perfect clock and a perfect command
+ * sequence talks to nothing at all if its signals are not routed to the
+ * socket, and on this handset they are not: S-Boot configures the pins for
+ * the internal eMMC, because it boots from it, and leaves the card slot's
+ * alone. The pins come up as GPIOs and the card never hears a thing.
+ *
+ * Exynos pin controllers are a set of banks, four registers each -- function
+ * (four bits a pin), data, pull (two bits a pin), drive strength. The device
+ * tree names which pins and which function:
+ *
+ *     sd2-clk            gpr4-0                  function 2
+ *     sd2-cmd            gpr4-1                  function 2
+ *     sd2-bus-width1     gpr4-2                  function 2
+ *     sd2-bus-width4     gpr4-3 gpr4-4 gpr4-5    function 2
+ *     dwmmc2_cd_ext_irq  gpa0-1                  function 15
+ *     dwmmc2_tflash_en   gpa0-3                  function 1, value 1
+ *
+ * The last line is the other half of the problem and is easy to miss: the
+ * card's supply is behind a GPIO, and Linux raises it before touching the
+ * controller. Nothing here was raising it, so the slot may have had no power
+ * at all through every attempt so far.
+ *
+ * Where the banks are. The device tree gives the blocks -- pinctrl3 is
+ * 0x13750000 -- but not the bank offsets inside them; those are in the pin
+ * controller itself. Exynos7870 is this part's sibling and its FSYS banks
+ * are gpr0 at 0x000, gpr1 at 0x020, gpr2 at 0x040, gpr3 at 0x060 and gpr4
+ * at 0x080, and taking that over cost a boot: this part's tree declares
+ * only three banks in the block, gpr0, gpr1 and gpr4. There is no gpr2 and
+ * no gpr3 here, so the banks are consecutive and gpr4 is at 0x040. 0x080 is
+ * a hole, and a hole reads as zero and swallows writes, which is exactly
+ * what it did -- the function register read back zero after being set, in a
+ * block whose base address the same boot had just proved correct.
+ *
+ * Two things are printed as proof rather than asserted. gpr1's function
+ * register must read 0x22222222: S-Boot sets the internal eMMC's eight data
+ * pins to function 2 because it boots from them. gpr0's must read
+ * 0x00000222: three pins, the eMMC's clock and command. If either is wrong
+ * the base or the layout is wrong and nothing else here should be believed.
+ * The whole block is dumped beside them.
+ *
+ * gpa0 is in the ALIVE block, whose banks run etc0, etc1, gpa0, gpa1, gpa2,
+ * gpq0. At 0x20 a bank that puts gpa0 at 0x040, which is less certain than
+ * gpr4 -- the etc banks need not be the same size -- so it is a boot
+ * argument and the whole block is dumped beside it.
+ */
+#define EXYNOS_PINCTRL_FSYS     0x13750000
+#define EXYNOS_PINCTRL_ALIVE    0x139f0000
+#define EXYNOS_PINCTRL_SIZE     0x1000
+
+#define EXYNOS_PIN_CON          0x00    /* 4 bits a pin: the function */
+#define EXYNOS_PIN_DAT          0x04    /* 1 bit a pin */
+#define EXYNOS_PIN_PUD          0x08    /* 2 bits a pin: 0 none, 1 down, 3 up */
+
+#define EXYNOS_GPR0             0x000
+#define EXYNOS_GPR1             0x020
+
+/* gpr4-0 through gpr4-5, all at function 2. */
+#define GPR4_CON_MASK           0x00ffffffu
+#define GPR4_CON_SD             0x00222222u
+
+/* No pull on the clock, pull-up on the command and the four data lines. */
+#define GPR4_PUD_MASK           0x00000fffu
+#define GPR4_PUD_SD             0x00000ffcu
+
+/* gpa0-3, the card's supply: function 1 is output, and it wants to be high. */
+#define GPA0_TFLASH_EN_PIN      3
+
+/*
+ * The low half of VERID is the IP revision, and every member of this family
+ * reads as 0x2xxA -- 0x240A and 0x270A are the ones commonly seen. It is not
+ * a value a dead or unmapped block produces, which is the whole point of
+ * looking at it.
+ */
+#define DWMMC_VERID_REV(v)      ((v) & 0xffff)
+
+/* CTRL */
+#define DWMMC_CTRL_RESET        (1u << 0)
+#define DWMMC_CTRL_FIFO_RESET   (1u << 1)
+#define DWMMC_CTRL_DMA_RESET    (1u << 2)
+#define DWMMC_CTRL_ALL_RESET    (DWMMC_CTRL_RESET | DWMMC_CTRL_FIFO_RESET | \
+	                         DWMMC_CTRL_DMA_RESET)
+
+/*
+ * HCON describes how this instance of the core was built.
+ *
+ * Bits 9:7 are H_DATA_WIDTH and they are the whole story of this driver's
+ * first real bug: 0 means the FIFO is 16 bits wide, 1 means 32 and 2 means
+ * 64. This controller reads 0x0be42541, so bits 9:7 are 0b010 and the FIFO
+ * is 64 bits wide. A 32-bit read of a 64-bit FIFO returns the low half and
+ * does not consume the entry, so the same word comes back forever, the FIFO
+ * never empties, and the controller eventually gives up on the host -- which
+ * is exactly what was seen: "EFI " repeated 128 times, STATUS reporting the
+ * FIFO still full at 64 entries, and HTO raised no matter how fast the drain
+ * loop ran.
+ *
+ * The device tree's fifo-depth of 64 agrees: 64 entries of 8 bytes is 512,
+ * one whole sector.
+ *
+ * Bit 22 is IMPLEMENT_HOLD_REG. This part sets both 22 and 23, so whichever
+ * of the two the documentation means, commands here carry USE_HOLD_REG
+ * either way and nothing about this board turns on getting it right.
+ */
+#define DWMMC_HCON_DATA_WIDTH(h)        (((h) >> 7) & 0x7)
+#define DWMMC_HCON_HOLD_REG             (1u << 22)
+
+/* CMD */
+#define DWMMC_CMD_INDEX(i)      ((i) & 0x3f)
+#define DWMMC_CMD_RESP_EXP      (1u << 6)
+#define DWMMC_CMD_RESP_LONG     (1u << 7)
+#define DWMMC_CMD_CHECK_CRC     (1u << 8)
+#define DWMMC_CMD_DATA_EXP      (1u << 9)
+#define DWMMC_CMD_WRITE         (1u << 10)
+#define DWMMC_CMD_PRV_DAT_WAIT  (1u << 13)
+#define DWMMC_CMD_SEND_INIT     (1u << 15)
+#define DWMMC_CMD_UPDATE_CLK    (1u << 21)
+#define DWMMC_CMD_USE_HOLD_REG  (1u << 29)
+#define DWMMC_CMD_START         (1u << 31)
+
+/* RINTSTS / INTMASK */
+#define DWMMC_INT_RE            (1u << 1)       /* response error */
+#define DWMMC_INT_CMD_DONE      (1u << 2)
+#define DWMMC_INT_DTO           (1u << 3)       /* data transfer over */
+#define DWMMC_INT_RCRC          (1u << 6)       /* response CRC */
+#define DWMMC_INT_DCRC          (1u << 7)       /* data CRC */
+#define DWMMC_INT_RTO           (1u << 8)       /* response timeout */
+#define DWMMC_INT_DRTO          (1u << 9)       /* data read timeout */
+#define DWMMC_INT_HTO           (1u << 10)
+#define DWMMC_INT_FRUN          (1u << 11)
+#define DWMMC_INT_HLE           (1u << 12)      /* hardware locked write */
+#define DWMMC_INT_SBE           (1u << 13)
+#define DWMMC_INT_EBE           (1u << 15)
+#define DWMMC_INT_ALL           0xffffffffu
+
+#define DWMMC_INT_CMD_ERR       (DWMMC_INT_RE | DWMMC_INT_RTO | \
+	                         DWMMC_INT_RCRC | DWMMC_INT_HLE)
+/*
+ * HTO is deliberately not in here.
+ *
+ * It means the host was late to the FIFO -- flow control, not corruption.
+ * The bits that say the data is wrong are DCRC, SBE and EBE; DRTO says the
+ * card never sent it and FRUN says the FIFO ran under. HTO on its own is
+ * survivable, and on this kernel it has been survived: the first working
+ * read raised HTO and still delivered all 128 words with no CRC error. A
+ * transfer that completes is a transfer that completes, whatever the
+ * controller thought of the host's timing on the way.
+ *
+ * It is still worth printing, because once this drives a filesystem rather
+ * than one sector at boot, a host that is habitually late is a real problem.
+ */
+#define DWMMC_INT_DATA_FATAL    (DWMMC_INT_DCRC | DWMMC_INT_DRTO | \
+	                         DWMMC_INT_FRUN | DWMMC_INT_SBE | \
+	                         DWMMC_INT_EBE)
+
+/* STATUS: the FIFO occupancy, in words. */
+#define DWMMC_STATUS_FIFO_COUNT(s)      (((s) >> 17) & 0x1fff)
+
+/*
+ * Command indices. The bring-up sequence is the standard one: idle the card,
+ * ask what it is, let it finish powering up, learn its address, select it.
+ * ACMD41 and ACMD6 are ordinary commands that must be preceded by CMD55.
+ */
+#define MMC_GO_IDLE_STATE       0
+#define MMC_ALL_SEND_CID        2
+#define SD_SEND_RELATIVE_ADDR   3
+#define SD_SET_BUS_WIDTH        6       /* ACMD6 */
+#define MMC_SELECT_CARD         7
+#define SD_SEND_IF_COND         8
+#define MMC_SET_BLOCKLEN        16
+#define MMC_READ_SINGLE_BLOCK   17
+#define SD_APP_OP_COND          41      /* ACMD41 */
+#define MMC_APP_CMD             55
+
+/* OCR, as ACMD41 returns it. */
+#define SD_OCR_BUSY             0x80000000u     /* clear while powering up */
+#define SD_OCR_CCS              0x40000000u     /* block addressing */
+#define SD_OCR_VOLTAGE          0x00ff8000u     /* 2.7 V to 3.6 V */
+#define SD_OCR_HCS              0x40000000u     /* in the argument: SDHC ok */
+
+/* CMD8's argument and the pattern the card echoes back. */
+#define SD_IF_COND_ARG          0x1aau
+#define SD_IF_COND_PATTERN      0xaau
+
+#define DWMMC_SECTOR            512
+
+/*
+ * How long to wait for each step, in microseconds. Generous: a read that is
+ * going to work finishes in well under a millisecond at this clock, and the
+ * only cost of a long limit is how long a dead controller takes to say so.
+ */
+#define DWMMC_TIMEOUT_US        500000
+
+/*
+ * The data phase spins instead of sleeping: a sector at this clock is over
+ * in well under a millisecond, and a delay(1) between polls is long enough
+ * for the FIFO to fill and the controller to give up on us. This is the
+ * iteration budget for that spin -- large enough to be no limit in practice,
+ * small enough that a dead transfer still ends.
+ */
+#define DWMMC_SPINS             2000000
+
+struct dwmmc_unit {
+	const char      *name;
+	vm_offset_t     base;           /* physical */
+	uint32_t        bit;            /* in the dwmmc_probe boot argument */
+};
+
+static const struct dwmmc_unit dwmmc_units[] = {
+	{ "dwmmc0 (internal eMMC)", 0x13540000, 1 },
+	{ "dwmmc2 (microSD slot)",  0x13560000, 2 },
+};
+
+static void dwmmc_blockdev_init(vm_offset_t regs, uint32_t hcon);
+
+/* dwmmc_read=<sectors> and dwmmc_lba=<first>; see dwmmc_probe(). */
+static uint32_t dwmmc_read_count = 0;
+static uint32_t dwmmc_read_lba = 0;
+
+/*
+ * The window /dev/mmc0 shows, and whether it has been published yet. Set
+ * from boot arguments; see dwmmc_probe() and the block device at the end.
+ */
+static uint32_t dwmmc_part_lba = 0;     /* first sector of the window */
+static uint32_t dwmmc_part_blocks = 0;  /* its length, in sectors */
+static int      dwmmc_bmajor = -1;
+
+/* dwmmc_scan_lba=<first> and dwmmc_scan_blocks=<count>; see dwmmc_scan(). */
+static uint32_t dwmmc_scan_lba = 0;
+static uint32_t dwmmc_scan_blocks = 0;
+
+/* dwmmc_pin=0 leaves the pins alone; see dwmmc_sd_pins(). */
+static uint32_t dwmmc_pin = 1;
+static uint32_t dwmmc_gpa0 = 0x040;
+static uint32_t dwmmc_gpr4 = 0x040;
+
+/*
+ * dwmmc_halt=1 stops the boot here.
+ *
+ * Not a debugging convenience: the console is a framebuffer with no
+ * scrollback, and the forty-odd lines bsd_init() prints after this scroll
+ * the probe's own output off the top of the screen before anyone can
+ * photograph it. The first attempt at the pin configuration lost exactly
+ * the two lines that said whether it had worked.
+ */
+static uint32_t dwmmc_halt = 0;
+
+/* dwmmc_sd=1 and the clock it uses; see dwmmc_sd_init(). */
+static uint32_t dwmmc_sd_enable = 0;
+static uint32_t dwmmc_sd_div = 125;     /* CLKDIV while identifying */
+static uint32_t dwmmc_sd_div_hi = 2;    /* CLKDIV once the card is selected */
+static uint32_t dwmmc_sd_width = 4;
+static uint32_t dwmmc_sd_clksel = 0;
+
+/*
+ * Cards of 2 GiB and under take a byte offset where larger ones take a block
+ * number. The eMMC path never changes this: every eMMC this will meet is far
+ * past that line, and the one in this handset is 16 GB.
+ */
+static uint32_t dwmmc_block_addressed = 1;
+
+/*
+ * The FIFO depth, latched the first time it is read.
+ *
+ * It is only legible in FIFOTH's reset value, so once that register has
+ * been written the number is gone -- and dwmmc_sd_prepare() writes it, and
+ * the clock sweep calls dwmmc_sd_prepare() twelve times. Reading it afresh
+ * each time gave a depth of 4 on the second pass and every pass after.
+ */
+static uint32_t dwmmc_fifo_depth = 0;
+
+#define DWMMC_READ_MAX          4
+
+/*
+ * Enough signatures to answer the question, and few enough that a range of
+ * random-looking bytes cannot fill the screen. The two-byte ext4 magic is
+ * the one that will produce false positives, and sixteen of those still fit
+ * above the fold.
+ */
+#define DWMMC_SCAN_MAX_HITS     16
+
+static uint32_t
+dwmmc_read(vm_offset_t regs, uint32_t off)
+{
+	return *(volatile uint32_t *)(regs + off);
+}
+
+static void
+dwmmc_write(vm_offset_t regs, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(regs + off) = val;
+}
+
+/* Name the bits of RINTSTS that mean something went wrong. */
+static void
+dwmmc_print_errors(const char *what, uint32_t sts)
+{
+	printf("dwmmc:   %s: RINTSTS 0x%08x%s%s%s%s%s%s%s%s%s\n", what, sts,
+	    (sts & DWMMC_INT_RE)   ? " RE" : "",
+	    (sts & DWMMC_INT_RTO)  ? " RTO(response timeout)" : "",
+	    (sts & DWMMC_INT_RCRC) ? " RCRC" : "",
+	    (sts & DWMMC_INT_HLE)  ? " HLE" : "",
+	    (sts & DWMMC_INT_DCRC) ? " DCRC" : "",
+	    (sts & DWMMC_INT_DRTO) ? " DRTO(data timeout)" : "",
+	    (sts & DWMMC_INT_HTO)  ? " HTO" : "",
+	    (sts & DWMMC_INT_SBE)  ? " SBE" : "",
+	    (sts & DWMMC_INT_EBE)  ? " EBE" : "");
+}
+
+
+/* ----------------------------------------------------- card bring-up ---- */
+
+/*
+ * Everything from here to dwmmc_read_block() exists for one controller:
+ * dwmmc2, the microSD slot.
+ *
+ * dwmmc0 needs none of it. S-Boot reads the boot image off the internal
+ * eMMC, so by the time this kernel runs that controller has a clock, a bus
+ * width and a selected card, and CMD17 works against state someone else
+ * set up. The probe's register dump shows the difference plainly:
+ *
+ *     dwmmc0   CTRL 0x00000010  CLKENA 0x00000001  CLKDIV 0x00000001
+ *     dwmmc2   CTRL 0x00000000  CLKENA 0x00000000  CLKDIV 0x00000000
+ *
+ * The SD controller is mapped and its bus clock is running -- VERID reads
+ * 0x5342270a, which a gated block does not produce -- but nothing has
+ * configured it and no card has been identified. So this is the standard
+ * sequence, written out: reset, clock, 74 idle clocks, CMD0 to idle the
+ * card, CMD8 to ask whether it speaks SD 2.0, ACMD41 until it finishes
+ * powering up, CMD2 and CMD3 to learn who it is, CMD7 to select it, ACMD6
+ * for four-bit, CMD16 for a 512-byte block, then the clock goes up.
+ *
+ * Why the SD card at all, when reading the eMMC already works: because
+ * getting a root filesystem onto the eMMC does not. Samsung's download-mode
+ * firmware erases the target partition and then declines to write anything
+ * that is not one of its own images -- a scan of all 409600 sectors of
+ * CACHE after a flash that reported success found zero bytes of data -- and
+ * there is no other way in. A card in the slot is written with dd from a
+ * PC, which puts the bootloader out of the loop entirely. It also avoids
+ * the SMU in dwmmc0's data path, which dwmmc2's tree bypasses.
+ *
+ * The clock is a boot argument because its input frequency is not known.
+ * S-Boot left dwmmc0 at CLKDIV 1, but the two controllers take separate
+ * dividers from the CMU and one says nothing about the other. CLKDIV n
+ * divides by 2n (n = 0 means divide by one), identification wants 100-400
+ * kHz, and the defaults here assume a 100 MHz input: 125 gives 400 kHz to
+ * identify with and 2 gives 25 MHz to read at. If CMD0 fails, that
+ * assumption is where to look first.
+ */
+
+/*
+ * Clock changes do not take effect when written. The core applies them when
+ * it is given a command with UPDATE_CLOCK_REGS_ONLY set, which sends nothing
+ * to the card.
+ */
+static int
+dwmmc_update_clk(vm_offset_t regs)
+{
+	int us;
+
+	dwmmc_write(regs, DWMMC_CMDARG, 0);
+	dwmmc_write(regs, DWMMC_CMD, DWMMC_CMD_START | DWMMC_CMD_UPDATE_CLK
+	    | DWMMC_CMD_PRV_DAT_WAIT);
+
+	for (us = 0; us < DWMMC_TIMEOUT_US; us++) {
+		if (!(dwmmc_read(regs, DWMMC_CMD) & DWMMC_CMD_START)) {
+			return 0;
+		}
+		delay(1);
+	}
+
+	printf("dwmmc:   the clock update was never accepted\n");
+	return -1;
+}
+
+/*
+ * The clock has to be off while the divider changes, and each of the three
+ * writes needs its own update: disable, divide, enable.
+ */
+static int
+dwmmc_set_clock(vm_offset_t regs, uint32_t div)
+{
+	dwmmc_write(regs, DWMMC_CLKENA, 0);
+	if (dwmmc_update_clk(regs) != 0) {
+		return -1;
+	}
+
+	dwmmc_write(regs, DWMMC_CLKSRC, 0);
+	dwmmc_write(regs, DWMMC_CLKDIV, div);
+	if (dwmmc_update_clk(regs) != 0) {
+		return -1;
+	}
+
+	dwmmc_write(regs, DWMMC_CLKENA, 1);     /* card 0, low-power off */
+	return dwmmc_update_clk(regs);
+}
+
+/*
+ * One command with no data phase.
+ *
+ * Three outcomes rather than two. Zero is an answer; -1 is a fault worth
+ * reporting; 1 is the card declining to answer at all, which is a normal
+ * reply to CMD8 from an SD 1.x card and to ACMD41 from one that is still
+ * powering up. Folding that into the error case would make a working card
+ * look broken.
+ */
+static int
+dwmmc_cmd(vm_offset_t regs, uint32_t hcon, uint32_t index, uint32_t arg,
+    uint32_t flags, uint32_t *resp)
+{
+	uint32_t cmd, sts = 0;
+	int us;
+
+	dwmmc_write(regs, DWMMC_RINTSTS, DWMMC_INT_ALL);
+	dwmmc_write(regs, DWMMC_CMDARG, arg);
+
+	cmd = DWMMC_CMD_INDEX(index) | flags | DWMMC_CMD_START;
+	if (hcon & DWMMC_HCON_HOLD_REG) {
+		cmd |= DWMMC_CMD_USE_HOLD_REG;
+	}
+	dwmmc_write(regs, DWMMC_CMD, cmd);
+
+	/* The core clears START once it has taken the command into its queue. */
+	for (us = 0; us < DWMMC_TIMEOUT_US; us++) {
+		if (!(dwmmc_read(regs, DWMMC_CMD) & DWMMC_CMD_START)) {
+			break;
+		}
+		delay(1);
+	}
+	if (us == DWMMC_TIMEOUT_US) {
+		printf("dwmmc:   CMD%u was never taken by the core\n", index);
+		return -1;
+	}
+
+	for (us = 0; us < DWMMC_TIMEOUT_US; us++) {
+		sts = dwmmc_read(regs, DWMMC_RINTSTS);
+		if (sts & (DWMMC_INT_CMD_DONE | DWMMC_INT_CMD_ERR)) {
+			break;
+		}
+		delay(1);
+	}
+	if (us == DWMMC_TIMEOUT_US) {
+		printf("dwmmc:   CMD%u never finished (RINTSTS 0x%08x)\n",
+		    index, dwmmc_read(regs, DWMMC_RINTSTS));
+		return -1;
+	}
+
+	if (resp != NULL) {
+		resp[0] = dwmmc_read(regs, DWMMC_RESP0);
+		resp[1] = dwmmc_read(regs, DWMMC_RESP1);
+		resp[2] = dwmmc_read(regs, DWMMC_RESP2);
+		resp[3] = dwmmc_read(regs, DWMMC_RESP3);
+	}
+
+	if (sts & DWMMC_INT_RTO) {
+		return 1;
+	}
+	if (sts & DWMMC_INT_CMD_ERR) {
+		printf("dwmmc:   CMD%u error: RINTSTS 0x%08x%s%s%s\n",
+		    index, sts,
+		    (sts & DWMMC_INT_RE) ? " RE" : "",
+		    (sts & DWMMC_INT_RCRC) ? " RCRC" : "",
+		    (sts & DWMMC_INT_HLE) ? " HLE" : "");
+		return -1;
+	}
+	return 0;
+}
+
+/* The flags every short-response command here shares. */
+#define DWMMC_CMD_R1    (DWMMC_CMD_RESP_EXP | DWMMC_CMD_CHECK_CRC | \
+	                 DWMMC_CMD_PRV_DAT_WAIT)
+
+
+/*
+ * Route the card slot's signals to the card slot, and turn its supply on.
+ *
+ * Read before written, and printed either way, because this writes to a pin
+ * controller shared with the rest of the board: gpr4 is the card slot and
+ * nothing else, but a wrong base address would be writing function codes
+ * into whatever is actually there. gpr1's function register is the check --
+ * see the comment on EXYNOS_PINCTRL_FSYS for why it must read 0x22222222 --
+ * and it is printed first so that a bad base is visible before the writes
+ * rather than after.
+ *
+ * Only the function and the pull are written. Drive strength is left as it
+ * is: the tree asks for 2 on these pins and 4 on gpa0-3, and a field that
+ * has to hold 4 is not the two bits a pull field has, so its width is not
+ * established here. The default drive is enough to talk to a card in a
+ * socket a centimetre away, and a wrong guess at a field width is a way to
+ * configure six pins into nonsense.
+ */
+static void
+dwmmc_sd_pins(void)
+{
+	vm_offset_t fsys, alive;
+	uint32_t con, pud;
+	unsigned int i;
+
+	fsys = ml_io_map(EXYNOS_PINCTRL_FSYS, EXYNOS_PINCTRL_SIZE);
+	if (fsys == 0) {
+		printf("dwmmc:   pinctrl at 0x%x could not be mapped\n",
+		    EXYNOS_PINCTRL_FSYS);
+		return;
+	}
+
+	for (i = 0; i < 6; i++) {
+		uint32_t off = i * 0x20;
+
+		printf("dwmmc:   fsys  +0x%03x: CON 0x%08x  DAT 0x%08x  "
+		    "PUD 0x%08x\n", off,
+		    dwmmc_read(fsys, off + EXYNOS_PIN_CON),
+		    dwmmc_read(fsys, off + EXYNOS_PIN_DAT),
+		    dwmmc_read(fsys, off + EXYNOS_PIN_PUD));
+	}
+
+	con = dwmmc_read(fsys, EXYNOS_GPR0 + EXYNOS_PIN_CON);
+	printf("dwmmc:   gpr0 CON 0x%08x %s\n", con,
+	    con == 0x00000222u ? "-- the eMMC's clock and command, as expected"
+	    : "-- EXPECTED 0x00000222");
+
+	con = dwmmc_read(fsys, EXYNOS_GPR1 + EXYNOS_PIN_CON);
+	printf("dwmmc:   gpr1 CON 0x%08x %s\n", con,
+	    con == 0x22222222u ? "-- the eMMC's eight data pins, as expected" :
+	    "-- EXPECTED 0x22222222; the base address may be wrong");
+
+	con = dwmmc_read(fsys, dwmmc_gpr4 + EXYNOS_PIN_CON);
+	pud = dwmmc_read(fsys, dwmmc_gpr4 + EXYNOS_PIN_PUD);
+	printf("dwmmc:   gpr4 (+0x%x) before: CON 0x%08x  PUD 0x%08x\n",
+	    dwmmc_gpr4, con, pud);
+
+	dwmmc_write(fsys, dwmmc_gpr4 + EXYNOS_PIN_CON,
+	    (con & ~GPR4_CON_MASK) | GPR4_CON_SD);
+	dwmmc_write(fsys, dwmmc_gpr4 + EXYNOS_PIN_PUD,
+	    (pud & ~GPR4_PUD_MASK) | GPR4_PUD_SD);
+
+	con = dwmmc_read(fsys, dwmmc_gpr4 + EXYNOS_PIN_CON);
+	printf("dwmmc:   gpr4 (+0x%x) after:  CON 0x%08x  PUD 0x%08x %s\n",
+	    dwmmc_gpr4, con,
+	    dwmmc_read(fsys, dwmmc_gpr4 + EXYNOS_PIN_PUD),
+	    (con & GPR4_CON_MASK) == GPR4_CON_SD ? "" :
+	    "-- THE WRITE DID NOT TAKE; this offset is probably a hole");
+
+	alive = ml_io_map(EXYNOS_PINCTRL_ALIVE, EXYNOS_PINCTRL_SIZE);
+	if (alive == 0) {
+		printf("dwmmc:   pinctrl at 0x%x could not be mapped\n",
+		    EXYNOS_PINCTRL_ALIVE);
+		return;
+	}
+
+	/*
+	 * The first six banks of the ALIVE block, so that gpa0 can be found
+	 * if 0x040 turns out to be the wrong one. The tree's order is etc0,
+	 * etc1, gpa0, gpa1, gpa2, gpq0.
+	 */
+	for (i = 0; i < 6; i++) {
+		uint32_t off = i * 0x20;
+
+		printf("dwmmc:   alive +0x%03x: CON 0x%08x  DAT 0x%08x  "
+		    "PUD 0x%08x\n", off,
+		    dwmmc_read(alive, off + EXYNOS_PIN_CON),
+		    dwmmc_read(alive, off + EXYNOS_PIN_DAT),
+		    dwmmc_read(alive, off + EXYNOS_PIN_PUD));
+	}
+
+	if (dwmmc_gpa0 == 0xffffffffu) {
+		printf("dwmmc:   leaving the card supply alone as asked\n");
+		return;
+	}
+
+	/*
+	 * The pull goes first. The tree asks for no pull on this pin and the
+	 * controller comes up with a pull-down on it, and while a pull should
+	 * not be able to hold a driven output down, the first attempt drove
+	 * this pin high and read it back low -- so the pull is removed before
+	 * the driver is asked to fight it, rather than after.
+	 */
+	pud = dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_PUD);
+	dwmmc_write(alive, dwmmc_gpa0 + EXYNOS_PIN_PUD,
+	    pud & ~(3u << (GPA0_TFLASH_EN_PIN * 2)));
+
+	con = dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_CON);
+	con &= ~(0xfu << (GPA0_TFLASH_EN_PIN * 4));
+	con |= 1u << (GPA0_TFLASH_EN_PIN * 4);          /* output */
+	dwmmc_write(alive, dwmmc_gpa0 + EXYNOS_PIN_CON, con);
+
+	dwmmc_write(alive, dwmmc_gpa0 + EXYNOS_PIN_DAT,
+	    dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_DAT)
+	    | (1u << GPA0_TFLASH_EN_PIN));
+
+	/*
+	 * Read back twice. Immediately, which says whether the register took
+	 * the write at all, and again after the supply has had time to come
+	 * up, which says what the pad is actually sitting at -- on these
+	 * controllers an output pin's data register can read the pad rather
+	 * than the latch, and the two answers mean different things.
+	 */
+	printf("dwmmc:   gpa0 (+0x%x) now: CON 0x%08x  DAT 0x%08x  "
+	    "PUD 0x%08x\n", dwmmc_gpa0,
+	    dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_CON),
+	    dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_DAT),
+	    dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_PUD));
+
+	delay(10000);
+
+	con = dwmmc_read(alive, dwmmc_gpa0 + EXYNOS_PIN_DAT);
+	printf("dwmmc:   card supply after 10 ms: DAT 0x%08x -- pin %u is "
+	    "%s\n", con, GPA0_TFLASH_EN_PIN,
+	    (con & (1u << GPA0_TFLASH_EN_PIN)) ? "high" : "STILL LOW");
+}
+
+/*
+ * Reset the controller, set the registers that do not depend on the card,
+ * start the clock at the given divider, and idle the card with CMD0.
+ *
+ * Separate from the rest because the sweep below runs it once per candidate
+ * divider, and a sweep that prepared the controller even slightly
+ * differently from the real bring-up would be measuring the wrong thing.
+ */
+static int
+dwmmc_sd_prepare(vm_offset_t regs, uint32_t hcon, uint32_t div)
+{
+	uint32_t depth, fifoth;
+	int us;
+
+	/*
+	 * A full reset, which on this controller is safe and on dwmmc0 would
+	 * not be: there is no clock, bus width or card selection here to
+	 * destroy, because nothing has set any.
+	 */
+	dwmmc_write(regs, DWMMC_CTRL, DWMMC_CTRL_ALL_RESET);
+	for (us = 0; us < DWMMC_TIMEOUT_US; us++) {
+		if (!(dwmmc_read(regs, DWMMC_CTRL) & DWMMC_CTRL_ALL_RESET)) {
+			break;
+		}
+		delay(1);
+	}
+	if (us == DWMMC_TIMEOUT_US) {
+		printf("dwmmc:   the controller reset never completed\n");
+		return -1;
+	}
+
+	/*
+	 * FIFOTH is read before it is written, and only once ever: its RX
+	 * watermark field holds the FIFO depth the core was built with until
+	 * something writes the register, and that is the only place the
+	 * number appears. Here it reads 0x003f0000, so the depth is 64 --
+	 * the same 64 entries of 8 bytes that make one sector.
+	 */
+	if (dwmmc_fifo_depth == 0) {
+		fifoth = dwmmc_read(regs, DWMMC_FIFOTH);
+		depth = ((fifoth >> 16) & 0xfff) + 1;
+		if (depth < 8 || depth > 4096) {
+			printf("dwmmc:   FIFOTH 0x%08x gives a depth of %u, "
+			    "which is not believable; using 64\n",
+			    fifoth, depth);
+			depth = 64;
+		}
+		dwmmc_fifo_depth = depth;
+	}
+	depth = dwmmc_fifo_depth;
+
+	dwmmc_write(regs, DWMMC_RINTSTS, DWMMC_INT_ALL);
+	dwmmc_write(regs, DWMMC_INTMASK, 0);
+	dwmmc_write(regs, DWMMC_TMOUT, 0xffffff40u);
+	dwmmc_write(regs, DWMMC_BLKSIZ, DWMMC_SECTOR);
+	dwmmc_write(regs, DWMMC_CTYPE, 0);      /* one bit until ACMD6 */
+	dwmmc_write(regs, DWMMC_PWREN, 1);
+	dwmmc_write(regs, DWMMC_CLKSEL, dwmmc_sd_clksel);
+	dwmmc_write(regs, DWMMC_FIFOTH,
+	    (((depth / 2) - 1) << 16) | (depth / 2));
+
+	if (dwmmc_set_clock(regs, div) != 0) {
+		return -1;
+	}
+
+	/*
+	 * The card wants 74 clocks of nothing before its first command. Two
+	 * milliseconds is far more than that at any identification clock, and
+	 * the cost of being generous is two milliseconds.
+	 */
+	delay(2000);
+
+	/*
+	 * CMD0 with SEND_INITIALIZATION, which makes the core send the idle
+	 * clocks itself. No response: the card does not answer this one, so
+	 * this says only that the core took the command -- not that anything
+	 * is listening.
+	 */
+	if (dwmmc_cmd(regs, hcon, MMC_GO_IDLE_STATE, 0,
+	    DWMMC_CMD_SEND_INIT | DWMMC_CMD_PRV_DAT_WAIT, NULL) < 0) {
+		printf("dwmmc:   CMD0 did not complete -- the core is not "
+		    "accepting commands at all\n");
+		return -1;
+	}
+	delay(2000);
+	return 0;
+}
+
+/*
+ * Try every plausible clock divider and report which, if any, the card
+ * answers at.
+ *
+ * This exists because the card interface clock's input frequency is not
+ * known and cannot be derived from anything on hand. S-Boot configured
+ * dwmmc0 and left dwmmc2 untouched, and the two take separate dividers from
+ * the CMU, so dwmmc0's CLKDIV of 1 says nothing about what this one is
+ * dividing. Identification has to happen between 100 and 400 kHz; guessing
+ * the input wrong by a factor of eight puts it outside that window in one
+ * direction or the other, and a card outside the window answers nothing,
+ * which looks exactly like a card that is not powered or not wired.
+ *
+ * Rather than guess once per boot, this guesses eleven times in one. CMD8
+ * and ACMD41 are the two questions worth asking: an SD 2.0 card answers the
+ * first and every card answers the second, so a divider at which either
+ * produces a non-zero response is the right order of magnitude. If none of
+ * them does, the clock is not what is wrong and the pin configuration or
+ * the card's supply is.
+ */
+static void
+dwmmc_sd_sweep(vm_offset_t regs, uint32_t hcon)
+{
+	static const uint32_t divs[] = {
+		0, 1, 2, 4, 8, 16, 32, 64, 125, 250, 500, 1000
+	};
+	uint32_t resp8[4], resp41[4];
+	unsigned int i;
+
+	if (dwmmc_pin) {
+		dwmmc_sd_pins();
+	}
+
+	printf("dwmmc:   sweeping the clock. CLKDIV n divides by 2n, except "
+	    "0, which divides by 1\n");
+
+	for (i = 0; i < sizeof(divs) / sizeof(divs[0]); i++) {
+		int rc8, rc41;
+
+		resp8[0] = resp41[0] = 0;
+
+		if (dwmmc_sd_prepare(regs, hcon, divs[i]) != 0) {
+			printf("dwmmc:     CLKDIV %4u: the controller would "
+			    "not start\n", divs[i]);
+			continue;
+		}
+
+		rc8 = dwmmc_cmd(regs, hcon, SD_SEND_IF_COND, SD_IF_COND_ARG,
+		    DWMMC_CMD_R1, resp8);
+
+		if (dwmmc_cmd(regs, hcon, MMC_APP_CMD, 0, DWMMC_CMD_R1,
+		    resp41) < 0) {
+			rc41 = -1;
+		} else {
+			rc41 = dwmmc_cmd(regs, hcon, SD_APP_OP_COND,
+			    SD_OCR_HCS | SD_OCR_VOLTAGE,
+			    DWMMC_CMD_RESP_EXP | DWMMC_CMD_PRV_DAT_WAIT,
+			    resp41);
+		}
+
+		printf("dwmmc:     CLKDIV %4u: CMD8 %d 0x%08x  ACMD41 %d "
+		    "0x%08x  STATUS 0x%08x\n", divs[i],
+		    rc8, resp8[0], rc41, resp41[0],
+		    dwmmc_read(regs, DWMMC_STATUS));
+	}
+
+	printf("dwmmc:   sweep done. 0 means the card answered, 1 means it "
+	    "stayed silent\n");
+}
+
+static int
+dwmmc_sd_init(vm_offset_t regs, uint32_t hcon)
+{
+	uint32_t resp[4];
+	uint32_t ocr = 0, rca;
+	int sd2 = 0, tries, rc;
+
+	printf("dwmmc:   card bring-up: CLKDIV %u to identify, %u to read, "
+	    "%u-bit, CLKSEL 0x%08x\n",
+	    dwmmc_sd_div, dwmmc_sd_div_hi, dwmmc_sd_width, dwmmc_sd_clksel);
+
+	if (dwmmc_pin) {
+		dwmmc_sd_pins();
+	}
+
+	if (dwmmc_sd_prepare(regs, hcon, dwmmc_sd_div) != 0) {
+		return -1;
+	}
+
+	/*
+	 * CMD8 asks whether the card understands SD 2.0 voltage signalling.
+	 * The argument carries a voltage range and a check pattern; a card
+	 * that understands it echoes the pattern back. Silence means SD 1.x,
+	 * which is not a failure, and changes only the HCS bit in ACMD41.
+	 */
+	rc = dwmmc_cmd(regs, hcon, SD_SEND_IF_COND, SD_IF_COND_ARG,
+	    DWMMC_CMD_R1, resp);
+	if (rc < 0) {
+		return -1;
+	}
+	if (rc == 0 && (resp[0] & 0xff) == SD_IF_COND_PATTERN) {
+		sd2 = 1;
+	}
+	printf("dwmmc:   CMD8: %s\n",
+	    sd2 ? "SD 2.0 or later" : "no answer, treating it as SD 1.x");
+
+	/*
+	 * ACMD41 until the card says it has finished powering up. Each one is
+	 * a CMD55 followed by CMD41; R3 carries no CRC, so asking the core to
+	 * check one would fail every single time.
+	 *
+	 * A card that does not answer is retried rather than given up on: a
+	 * card still bringing its internal supply up may ignore a command
+	 * outright, and the loop already has a bound and a clear thing to say
+	 * when it runs out. Only a real fault -- a CRC or a hardware-locked
+	 * write -- ends it early.
+	 */
+	for (tries = 0; tries < 1000; tries++) {
+		if (dwmmc_cmd(regs, hcon, MMC_APP_CMD, 0,
+		    DWMMC_CMD_R1, resp) < 0) {
+			printf("dwmmc:   CMD55 failed on try %d\n", tries);
+			return -1;
+		}
+		if (dwmmc_cmd(regs, hcon, SD_APP_OP_COND,
+		    (sd2 ? SD_OCR_HCS : 0u) | SD_OCR_VOLTAGE,
+		    DWMMC_CMD_RESP_EXP | DWMMC_CMD_PRV_DAT_WAIT, resp) < 0) {
+			printf("dwmmc:   ACMD41 failed on try %d\n", tries);
+			return -1;
+		}
+		ocr = resp[0];
+		if (ocr & SD_OCR_BUSY) {
+			break;
+		}
+		delay(1000);
+	}
+	if (!(ocr & SD_OCR_BUSY)) {
+		printf("dwmmc:   the card never finished powering up "
+		    "(OCR 0x%08x)\n", ocr);
+		return -1;
+	}
+
+	dwmmc_block_addressed = (ocr & SD_OCR_CCS) ? 1 : 0;
+	printf("dwmmc:   OCR 0x%08x after %d tries: %s addressing\n",
+	    ocr, tries + 1,
+	    dwmmc_block_addressed ? "block, SDHC or larger" : "byte, SDSC");
+
+	if (dwmmc_cmd(regs, hcon, MMC_ALL_SEND_CID, 0,
+	    DWMMC_CMD_RESP_EXP | DWMMC_CMD_RESP_LONG | DWMMC_CMD_CHECK_CRC
+	    | DWMMC_CMD_PRV_DAT_WAIT, resp) != 0) {
+		printf("dwmmc:   CMD2 failed\n");
+		return -1;
+	}
+	printf("dwmmc:   CID %08x %08x %08x %08x\n",
+	    resp[3], resp[2], resp[1], resp[0]);
+
+	if (dwmmc_cmd(regs, hcon, SD_SEND_RELATIVE_ADDR, 0,
+	    DWMMC_CMD_R1, resp) != 0) {
+		printf("dwmmc:   CMD3 failed\n");
+		return -1;
+	}
+	rca = resp[0] >> 16;
+	printf("dwmmc:   the card took RCA 0x%04x\n", rca);
+
+	if (dwmmc_cmd(regs, hcon, MMC_SELECT_CARD, rca << 16,
+	    DWMMC_CMD_R1, resp) != 0) {
+		printf("dwmmc:   CMD7 failed\n");
+		return -1;
+	}
+
+	/*
+	 * Four bits if asked for, and one if the card refuses. A refusal here
+	 * is not worth failing the whole bring-up over: a 1-bit card is four
+	 * times slower and entirely usable.
+	 */
+	if (dwmmc_sd_width == 4) {
+		if (dwmmc_cmd(regs, hcon, MMC_APP_CMD, rca << 16,
+		    DWMMC_CMD_R1, resp) == 0 &&
+		    dwmmc_cmd(regs, hcon, SD_SET_BUS_WIDTH, 2,
+		    DWMMC_CMD_R1, resp) == 0) {
+			dwmmc_write(regs, DWMMC_CTYPE, 1);
+			printf("dwmmc:   bus width is now 4 bits\n");
+		} else {
+			printf("dwmmc:   ACMD6 refused; staying at 1 bit\n");
+		}
+	}
+
+	/*
+	 * 512 bytes a block. An SDHC card is fixed at that and ignores this;
+	 * an SDSC card is not, and this is what makes the two behave alike
+	 * everywhere above.
+	 */
+	if (dwmmc_cmd(regs, hcon, MMC_SET_BLOCKLEN, DWMMC_SECTOR,
+	    DWMMC_CMD_R1, resp) != 0) {
+		printf("dwmmc:   CMD16 failed\n");
+		return -1;
+	}
+
+	if (dwmmc_set_clock(regs, dwmmc_sd_div_hi) != 0) {
+		return -1;
+	}
+	delay(1000);
+
+	printf("dwmmc:   card ready: CLKENA 0x%08x CLKDIV 0x%08x "
+	    "CTYPE 0x%08x STATUS 0x%08x\n",
+	    dwmmc_read(regs, DWMMC_CLKENA), dwmmc_read(regs, DWMMC_CLKDIV),
+	    dwmmc_read(regs, DWMMC_CTYPE), dwmmc_read(regs, DWMMC_STATUS));
+	return 0;
+}
+
+/*
+ * One 512-byte sector, by CMD17, using whatever state the bootloader left.
+ *
+ * buf is 128 words. The FIFO is drained as it fills rather than after the
+ * transfer: it is 64 words deep and a sector is 128, so waiting for DTO
+ * first would stall the controller half way with a full FIFO and look
+ * exactly like a dead card.
+ */
+static int
+dwmmc_read_block(vm_offset_t regs, uint32_t hcon, uint32_t lba, void *buf,
+    int verbose)
+{
+	/*
+	 * The FIFO is read in the width the core was built with, which is
+	 * what HCON says and not what is convenient. See DWMMC_HCON_DATA_WIDTH.
+	 */
+	const uint32_t fifo_bytes = 2u << DWMMC_HCON_DATA_WIDTH(hcon);
+	uint8_t *out = buf;
+	uint32_t cmd, sts, resp;
+	uint32_t got = 0;               /* bytes */
+	int us;
+
+	if (fifo_bytes != 4 && fifo_bytes != 8) {
+		printf("dwmmc:   HCON says the FIFO is %u bytes wide, which "
+		    "this does not know how to read\n", fifo_bytes);
+		return -1;
+	}
+
+	/*
+	 * A clean FIFO and a clean status, and nothing else. CTRL_RESET would
+	 * discard the clock, bus width and card selection that this depends
+	 * on, so the controller itself is not reset.
+	 */
+	dwmmc_write(regs, DWMMC_CTRL,
+	    dwmmc_read(regs, DWMMC_CTRL) | DWMMC_CTRL_FIFO_RESET);
+	for (us = 0; us < DWMMC_TIMEOUT_US; us++) {
+		if (!(dwmmc_read(regs, DWMMC_CTRL) & DWMMC_CTRL_FIFO_RESET)) {
+			break;
+		}
+		delay(1);
+	}
+	if (us == DWMMC_TIMEOUT_US) {
+		printf("dwmmc:   FIFO reset never completed\n");
+		return -1;
+	}
+
+	dwmmc_write(regs, DWMMC_RINTSTS, DWMMC_INT_ALL);
+	dwmmc_write(regs, DWMMC_BLKSIZ, DWMMC_SECTOR);
+	dwmmc_write(regs, DWMMC_BYTCNT, DWMMC_SECTOR);
+
+	/*
+	 * A generous data timeout. The upper 24 bits are counted in card
+	 * clock cycles and bound how long the controller will wait for the
+	 * host to service the FIFO before raising HTO.
+	 */
+	dwmmc_write(regs, DWMMC_TMOUT, 0xffffff40u);
+
+	/*
+	 * Block addressing unless the card said otherwise. Every eMMC uses
+	 * it and so does every SD card past 2 GiB; dwmmc_sd_init() clears
+	 * this for the small ones, which take a byte offset instead.
+	 */
+	dwmmc_write(regs, DWMMC_CMDARG,
+	    dwmmc_block_addressed ? lba : lba * DWMMC_SECTOR);
+
+	cmd = DWMMC_CMD_INDEX(MMC_READ_SINGLE_BLOCK)
+	    | DWMMC_CMD_RESP_EXP | DWMMC_CMD_CHECK_CRC
+	    | DWMMC_CMD_DATA_EXP | DWMMC_CMD_PRV_DAT_WAIT
+	    | DWMMC_CMD_START;
+	if (hcon & DWMMC_HCON_HOLD_REG) {
+		cmd |= DWMMC_CMD_USE_HOLD_REG;
+	}
+
+	dwmmc_write(regs, DWMMC_CMD, cmd);
+
+	/*
+	 * From here to the end of the transfer there is no printf and no
+	 * delay, and that is deliberate.
+	 *
+	 * An earlier version printed the card's response between the command
+	 * and the drain. Writing one line to this console means rendering
+	 * glyphs into a 720x1280 framebuffer, which takes milliseconds; the
+	 * card fills the FIFO in microseconds. So command completion and the
+	 * drain are one loop, with not even a wait for the controller to
+	 * accept the command in front of it, and anything worth saying is
+	 * saved and said afterwards.
+	 */
+	for (us = 0; us < DWMMC_SPINS; us++) {
+		uint32_t now = dwmmc_read(regs, DWMMC_RINTSTS);
+		uint32_t avail;
+
+		if (now & DWMMC_INT_CMD_ERR) {
+			sts = now;
+			goto cmd_failed;
+		}
+
+		/* FIFO_COUNT is in entries, and an entry is fifo_bytes wide. */
+		avail = DWMMC_STATUS_FIFO_COUNT(dwmmc_read(regs, DWMMC_STATUS));
+		while (avail-- > 0 && got < DWMMC_SECTOR) {
+			/*
+			 * A 64-bit entry is taken as two 32-bit reads, low
+			 * half then high half. Not a convenience: this core
+			 * does not allow a 64-bit access to the FIFO at all,
+			 * and what consumes the entry is reading the second
+			 * half. See the note above DWMMC_DATA.
+			 */
+			*(uint32_t *)(void *)(out + got) =
+			    dwmmc_read(regs, DWMMC_DATA);
+			if (fifo_bytes == 8) {
+				*(uint32_t *)(void *)(out + got + 4) =
+				    dwmmc_read(regs, DWMMC_DATA + 4);
+			}
+			got += fifo_bytes;
+		}
+
+		if (now & DWMMC_INT_DATA_FATAL) {
+			sts = now;
+			goto data_failed;
+		}
+		if (got == DWMMC_SECTOR && (now & DWMMC_INT_DTO)) {
+			break;
+		}
+	}
+
+	sts = dwmmc_read(regs, DWMMC_RINTSTS);
+	resp = dwmmc_read(regs, DWMMC_RESP0);
+
+	if (got < DWMMC_SECTOR) {
+		printf("dwmmc:   short read: %u of %u bytes, RESP0 0x%08x\n",
+		    got, (uint32_t)DWMMC_SECTOR, resp);
+		dwmmc_print_errors("at the end", sts);
+		return -1;
+	}
+
+	/*
+	 * A whole sector and none of the bits that mean it is wrong. HTO and
+	 * a missing DTO are reported but not treated as failure: HTO means
+	 * the host was late to the FIFO, and once it fires the core abandons
+	 * the data phase, so the absent DTO follows from it. With the FIFO
+	 * read at its real width neither should appear again, and if they do
+	 * the bytes below are still the thing that settles it.
+	 */
+	/*
+	 * Only the probe says anything. Once this is answering a filesystem
+	 * there are thousands of these a second, and a printf in the data
+	 * path is the bug this driver has already been bitten by once.
+	 */
+	if (verbose) {
+		if (sts & (DWMMC_INT_HTO | DWMMC_INT_DTO)) {
+			printf("dwmmc:   %s, %s\n",
+			    (sts & DWMMC_INT_HTO) ? "HTO raised" : "no HTO",
+			    (sts & DWMMC_INT_DTO) ? "transfer closed"
+			    : "no DTO");
+		}
+		printf("dwmmc:   CMD17 done: RESP0 0x%08x (state %u%s), "
+		    "RINTSTS 0x%08x, STATUS 0x%08x, FIFO %u bytes wide\n",
+		    resp, (resp >> 9) & 0xf,
+		    ((resp >> 9) & 0xf) == 4 ? " = tran" : "", sts,
+		    dwmmc_read(regs, DWMMC_STATUS), fifo_bytes);
+	}
+	return 0;
+
+cmd_failed:
+	resp = dwmmc_read(regs, DWMMC_RESP0);
+	dwmmc_print_errors("command rejected", sts);
+	if (sts & DWMMC_INT_RTO) {
+		printf("dwmmc:   a response timeout here means the card is "
+		    "not selected; it needs a full CMD0..CMD7 bring-up after "
+		    "all\n");
+	}
+	return -1;
+
+data_failed:
+	dwmmc_print_errors("data error", sts);
+	printf("dwmmc:   %u of %u bytes had arrived\n", got,
+	    (uint32_t)DWMMC_SECTOR);
+	return -1;
+}
+
+/*
+ * The first 64 bytes, and whatever the sector announces itself to be.
+ *
+ * On a Samsung handset LBA 0 is a protective MBR, so the 0x55AA at offset
+ * 510 is the thing to look for: finding it means the bytes came off the card
+ * and arrived in the right order, which no amount of plausible-looking hex
+ * can establish on its own.
+ */
+static void
+dwmmc_dump_sector(uint32_t lba, const void *buf)
+{
+	const unsigned char *b = (const unsigned char *)buf;
+	int row;
+
+	printf("dwmmc:   LBA %u:\n", lba);
+	for (row = 0; row < 4; row++) {
+		const unsigned char *p = b + row * 16;
+
+		printf("dwmmc:     %03x  %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x  %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    row * 16,
+		    p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7],
+		    p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+	}
+
+	if (b[510] == 0x55 && b[511] == 0xaa) {
+		printf("dwmmc:     ends 55 aa -- a partition table signature\n");
+	} else if (b[0] == 'E' && b[1] == 'F' && b[2] == 'I' && b[3] == ' '
+	    && b[4] == 'P' && b[5] == 'A' && b[6] == 'R' && b[7] == 'T') {
+		printf("dwmmc:     starts \"EFI PART\" -- a GPT header\n");
+	} else {
+		printf("dwmmc:     no signature here (bytes 510-511 are "
+		    "%02x %02x)\n", b[510], b[511]);
+	}
+}
+
+/*
+ * Look through a range of sectors for the start of a filesystem.
+ *
+ * This exists because "the image is not where we put it" and "the image was
+ * never written at all" look identical in a single-sector dump -- both are a
+ * screen of zeroes -- and the two call for opposite next moves. A scan tells
+ * them apart. If the volume landed anywhere in the range its header turns up
+ * at a sector that can be named; if the range is empty, nothing was written
+ * and the tool that was supposed to write it is the problem.
+ *
+ * Three things are worth printing, in descending order of how much they
+ * settle. A signature is the answer outright. The first sector that is not
+ * all zeroes is nearly as good: a volume whose header this does not
+ * recognise still has bytes in it, and knowing where they start bounds the
+ * search. The tally at the end separates "a filesystem is here" from "a few
+ * stray blocks survived an erase".
+ *
+ * Progress is printed every 65536 sectors because a scan of a 200 MiB
+ * partition is a minute of silence otherwise, and a minute of silence and a
+ * hang look the same from across the room.
+ */
+static void
+dwmmc_scan(vm_offset_t regs, uint32_t hcon, uint32_t first, uint32_t count)
+{
+	uint64_t buf[DWMMC_SECTOR / 8];
+	const unsigned char *b = (const unsigned char *)(const void *)buf;
+	uint32_t n, hits = 0, nonzero = 0;
+	int found_first = 0;
+
+	printf("dwmmc:   scanning %u sectors from LBA %u (%u MiB)\n",
+	    count, first, count / 2048);
+
+	for (n = 0; n < count; n++) {
+		uint32_t lba = first + n;
+		uint32_t i;
+		int empty = 1;
+
+		if (dwmmc_read_block(regs, hcon, lba, buf, 0) != 0) {
+			printf("dwmmc:   read of LBA %u failed; scan stops "
+			    "here\n", lba);
+			break;
+		}
+
+		for (i = 0; i < DWMMC_SECTOR / 8; i++) {
+			if (buf[i] != 0) {
+				empty = 0;
+				break;
+			}
+		}
+
+		if (!empty) {
+			nonzero++;
+			if (!found_first) {
+				found_first = 1;
+				printf("dwmmc:   first sector with data: "
+				    "LBA %u (+%u)\n", lba, n);
+			}
+		}
+
+		/*
+		 * HFS+ and HFSX put their volume header 1024 bytes into the
+		 * volume, so a header found here means the volume itself
+		 * begins two sectors earlier. ext4's magic sits at offset
+		 * 0x38 of a superblock that is also 1024 bytes in.
+		 */
+		if (b[0] == 'H' && b[1] == '+' && b[2] == 0 && b[3] == 4) {
+			printf("dwmmc:   HFS+ header at LBA %u (+%u): volume "
+			    "starts at LBA %u\n", lba, n, lba - 2);
+			hits++;
+		} else if (b[0] == 'H' && b[1] == 'X' && b[2] == 0 &&
+		    b[3] == 5) {
+			printf("dwmmc:   HFSX header at LBA %u (+%u): volume "
+			    "starts at LBA %u\n", lba, n, lba - 2);
+			hits++;
+		} else if (b[0] == 'E' && b[1] == 'F' && b[2] == 'I' &&
+		    b[3] == ' ' && b[4] == 'P' && b[5] == 'A' &&
+		    b[6] == 'R' && b[7] == 'T') {
+			printf("dwmmc:   GPT header at LBA %u (+%u)\n",
+			    lba, n);
+			hits++;
+		} else if (b[0x38] == 0x53 && b[0x39] == 0xef) {
+			printf("dwmmc:   ext4 superblock at LBA %u (+%u): "
+			    "volume starts at LBA %u\n", lba, n, lba - 2);
+			hits++;
+		}
+
+		if (hits >= DWMMC_SCAN_MAX_HITS) {
+			printf("dwmmc:   %u signatures is enough; stopping\n",
+			    hits);
+			n++;
+			break;
+		}
+
+		if ((n & 0xffff) == 0xffff) {
+			printf("dwmmc:   ... %u sectors so far, %u with "
+			    "data\n", n + 1, nonzero);
+		}
+	}
+
+	printf("dwmmc:   scan done: %u signatures, %u of %u sectors had "
+	    "data\n", hits, nonzero, n);
+}
+
+static void
+dwmmc_probe_one(const struct dwmmc_unit *unit)
+{
+	vm_offset_t regs;
+	uint32_t verid, hcon, usrid, ctrl, status, cdetect;
+	uint32_t clkena, clkdiv, ctype, blksiz, fifoth, bmod;
+	int alive = 0;
+
+	regs = ml_io_map(unit->base, DWMMC_REGS_SIZE);
+	if (regs == 0) {
+		printf("dwmmc: %s: ml_io_map(0x%lx) failed\n",
+		    unit->name, (unsigned long)unit->base);
+		return;
+	}
+
+	printf("dwmmc: %s at 0x%lx, mapped\n",
+	    unit->name, (unsigned long)unit->base);
+
+	/*
+	 * VERID first and on its own line. If the block is not there, this is
+	 * where the boot stops, and the line above will be the last thing on
+	 * the screen -- which says exactly as much as a value would have.
+	 */
+	verid = dwmmc_read(regs, DWMMC_VERID);
+	hcon = dwmmc_read(regs, DWMMC_HCON);
+	usrid = dwmmc_read(regs, DWMMC_USRID);
+
+	printf("dwmmc:   VERID 0x%08x (rev 0x%04x)  HCON 0x%08x  USRID 0x%08x\n",
+	    verid, DWMMC_VERID_REV(verid), hcon, usrid);
+
+	ctrl = dwmmc_read(regs, DWMMC_CTRL);
+	status = dwmmc_read(regs, DWMMC_STATUS);
+	cdetect = dwmmc_read(regs, DWMMC_CDETECT);
+	bmod = dwmmc_read(regs, DWMMC_BMOD);
+
+	printf("dwmmc:   CTRL 0x%08x  STATUS 0x%08x  CDETECT 0x%08x  "
+	    "BMOD 0x%08x\n", ctrl, status, cdetect, bmod);
+
+	clkena = dwmmc_read(regs, DWMMC_CLKENA);
+	clkdiv = dwmmc_read(regs, DWMMC_CLKDIV);
+	ctype = dwmmc_read(regs, DWMMC_CTYPE);
+	blksiz = dwmmc_read(regs, DWMMC_BLKSIZ);
+	fifoth = dwmmc_read(regs, DWMMC_FIFOTH);
+
+	printf("dwmmc:   CLKENA 0x%08x  CLKDIV 0x%08x  CTYPE 0x%08x  "
+	    "BLKSIZ 0x%08x  FIFOTH 0x%08x\n",
+	    clkena, clkdiv, ctype, blksiz, fifoth);
+
+	/*
+	 * The verdict, so that a photograph of the screen does not have to be
+	 * read against a datasheet.
+	 *
+	 * CDETECT is reported but deliberately not judged: bit 0 is low when a
+	 * card is present, and dwmmc0's tree says broken-card-detect, so on
+	 * the eMMC the bit means nothing at all.
+	 */
+	if (verid == 0 || verid == 0xffffffff) {
+		printf("dwmmc:   VERID reads as 0x%08x -- the block is not "
+		    "responding\n", verid);
+	} else if ((DWMMC_VERID_REV(verid) & 0xf000) != 0x2000) {
+		printf("dwmmc:   revision 0x%04x is not one this family "
+		    "produces; check the address\n", DWMMC_VERID_REV(verid));
+	} else {
+		printf("dwmmc:   alive: mapping, bus and clock all work\n");
+		alive = 1;
+	}
+
+	/*
+	 * dwmmc2 needs its card brought up before any of the rest means
+	 * anything; dwmmc0 arrives already configured by S-Boot and must not
+	 * be reset. See dwmmc_sd_init().
+	 */
+	if (alive && dwmmc_sd_enable && (unit->bit & 2) != 0) {
+		if (dwmmc_sd_enable == 2) {
+			dwmmc_sd_sweep(regs, hcon);
+			return;
+		}
+		if (dwmmc_sd_init(regs, hcon) != 0) {
+			printf("dwmmc:   card bring-up failed; nothing "
+			    "further on this controller\n");
+			return;
+		}
+	}
+
+	/*
+	 * Reading is asked for rather than assumed. The probe is safe on any
+	 * controller; a command is not, and this one is the phone's own
+	 * storage.
+	 */
+	if (dwmmc_read_count > 0) {
+		/* uint64_t, so a 64-bit FIFO read lands aligned. */
+		uint64_t buf[DWMMC_SECTOR / 8];
+		uint32_t n;
+
+		for (n = 0; n < dwmmc_read_count; n++) {
+			if (dwmmc_read_block(regs, hcon,
+			    dwmmc_read_lba + n, buf, 1) != 0) {
+				printf("dwmmc:   read of LBA %u failed\n",
+				    dwmmc_read_lba + n);
+				break;
+			}
+			dwmmc_dump_sector(dwmmc_read_lba + n, buf);
+		}
+	}
+
+	if (alive && dwmmc_scan_blocks > 0) {
+		dwmmc_scan(regs, hcon, dwmmc_scan_lba, dwmmc_scan_blocks);
+	}
+
+	/*
+	 * Publish the device only once, and only on a controller that
+	 * answered. dwmmc_part_blocks is what asks for it at all.
+	 */
+	if (alive && dwmmc_part_blocks != 0 && dwmmc_bmajor < 0) {
+		dwmmc_blockdev_init(regs, hcon);
+	}
+}
+
+/*
+ * Called from bsd_init() after bsd_autoconf(), which is late enough for
+ * printf to reach the console and early enough to be before the root mount
+ * this is eventually meant to serve.
+ *
+ * dwmmc_probe=<mask>: bit 0 is dwmmc0, bit 1 is dwmmc2. Default 1. See the
+ * header on why dwmmc2 is not probed unless it is asked for.
+ *
+ * dwmmc_read=<sectors>, dwmmc_lba=<first>: send CMD17 that many times, from
+ * that sector, and print what comes back. Default 0, which sends no command
+ * at all -- the probe only reads identity registers, and that is safe on any
+ * controller, whereas a command is not.
+ *
+ * dwmmc_sd=1: bring the card in the microSD slot up before reading, which
+ * dwmmc2 needs and dwmmc0 must not be given. dwmmc_sd=2 instead sweeps
+ * every plausible clock divider and reports which the card answers at,
+ * which is how to find out whether the clock is the problem; see
+ * dwmmc_sd_sweep(). dwmmc_sd_div=<n> and
+ * dwmmc_sd_div_hi=<n> are the CLKDIV used to identify the card and to read
+ * it (divide by 2n; 0 divides by one), dwmmc_sd_width=<1|4> the bus width,
+ * and dwmmc_sd_clksel=<hex> Samsung's phase register. See dwmmc_sd_init()
+ * for why the clock is not simply known.
+ *
+ * dwmmc_halt=1: spin forever once the probe is done, so that the rest of
+ * the boot does not scroll its output off a console with no scrollback.
+ *
+ * dwmmc_pin=0: do not touch the pin controller. On by default, because the
+ * card slot's pins come up as GPIOs and its supply comes up off; see
+ * dwmmc_sd_pins(). dwmmc_gpr4=<offset> and dwmmc_gpa0=<offset> move the
+ * banks that carry the card's signals and its supply, and dwmmc_gpa0 set to
+ * 0xffffffff leaves the supply alone.
+ *
+ * dwmmc_scan_lba=<first>, dwmmc_scan_blocks=<count>: read that whole range
+ * and print every filesystem signature in it, plus the first sector that is
+ * not all zeroes. Default 0 blocks, which scans nothing. Use it when a
+ * single dump comes back empty and the question is whether the data landed
+ * somewhere else or was never written; see dwmmc_scan().
+ *
+ * dwmmc_part_lba=<first>, dwmmc_part_blocks=<count>: publish /dev/mmc0 as a
+ * read-only window onto that range of the card, so that rd=mmc0 can root on
+ * it. Default 0 blocks, which publishes nothing. The numbers come from the
+ * PIT; on this handset CACHE is 6127616 + 409600 and SYSTEM is 491520 +
+ * 5636096.
+ */
+void dwmmc_probe(void);
+
+void
+dwmmc_probe(void)
+{
+	uint32_t mask = 1;
+	unsigned int i;
+
+	(void)PE_parse_boot_argn("dwmmc_probe", &mask, sizeof(mask));
+	(void)PE_parse_boot_argn("dwmmc_read", &dwmmc_read_count,
+	    sizeof(dwmmc_read_count));
+	(void)PE_parse_boot_argn("dwmmc_lba", &dwmmc_read_lba,
+	    sizeof(dwmmc_read_lba));
+	(void)PE_parse_boot_argn("dwmmc_halt", &dwmmc_halt,
+	    sizeof(dwmmc_halt));
+	(void)PE_parse_boot_argn("dwmmc_pin", &dwmmc_pin, sizeof(dwmmc_pin));
+	(void)PE_parse_boot_argn("dwmmc_gpa0", &dwmmc_gpa0,
+	    sizeof(dwmmc_gpa0));
+	(void)PE_parse_boot_argn("dwmmc_gpr4", &dwmmc_gpr4,
+	    sizeof(dwmmc_gpr4));
+	(void)PE_parse_boot_argn("dwmmc_sd", &dwmmc_sd_enable,
+	    sizeof(dwmmc_sd_enable));
+	(void)PE_parse_boot_argn("dwmmc_sd_div", &dwmmc_sd_div,
+	    sizeof(dwmmc_sd_div));
+	(void)PE_parse_boot_argn("dwmmc_sd_div_hi", &dwmmc_sd_div_hi,
+	    sizeof(dwmmc_sd_div_hi));
+	(void)PE_parse_boot_argn("dwmmc_sd_width", &dwmmc_sd_width,
+	    sizeof(dwmmc_sd_width));
+	(void)PE_parse_boot_argn("dwmmc_sd_clksel", &dwmmc_sd_clksel,
+	    sizeof(dwmmc_sd_clksel));
+	(void)PE_parse_boot_argn("dwmmc_scan_lba", &dwmmc_scan_lba,
+	    sizeof(dwmmc_scan_lba));
+	(void)PE_parse_boot_argn("dwmmc_scan_blocks", &dwmmc_scan_blocks,
+	    sizeof(dwmmc_scan_blocks));
+	(void)PE_parse_boot_argn("dwmmc_part_lba", &dwmmc_part_lba,
+	    sizeof(dwmmc_part_lba));
+	(void)PE_parse_boot_argn("dwmmc_part_blocks", &dwmmc_part_blocks,
+	    sizeof(dwmmc_part_blocks));
+
+	if (dwmmc_read_count > DWMMC_READ_MAX) {
+		dwmmc_read_count = DWMMC_READ_MAX;
+	}
+
+	if (mask == 0) {
+		return;
+	}
+
+	for (i = 0; i < sizeof(dwmmc_units) / sizeof(dwmmc_units[0]); i++) {
+		if (mask & dwmmc_units[i].bit) {
+			dwmmc_probe_one(&dwmmc_units[i]);
+		}
+	}
+
+	if (dwmmc_halt) {
+		printf("dwmmc: dwmmc_halt is set; stopping here so this stays "
+		    "on the screen\n");
+		for (;;) {
+			delay(1000000);
+		}
+	}
+}
+
+/* ------------------------------------------------------- block device ---- */
+
+/*
+ * The same controller, as something the filesystem layer can mount.
+ *
+ * This is a bdevsw, not an IOKit storage stack. The root device is a dev_t;
+ * IOBlockStorageDevice under IOBlockStorageDriver is how a real handset
+ * arrives at one, but IOStorageFamily is a separate kext and is not in this
+ * tree, so that road starts by building another kext into the kernel.
+ * bsd/dev/memdev.c -- already patched here so that rd=md0 works -- shows the
+ * smaller shape: a strategy routine and two devfs nodes. This is that, with
+ * CMD17 where memdev has a bcopy.
+ *
+ * Read-only, and not as a precaution that could be relaxed later: there is
+ * no code here that can write to the card at all. This is the phone's own
+ * eMMC, with Android's partitions on it, and the kernel that is learning to
+ * talk to it is three days old. vfs_subr.c:1022 sets MNT_RDONLY | MNT_ROOTFS
+ * on the root mount before trying any filesystem, so nothing is given up:
+ * the root is mounted read-only whatever the device could do.
+ *
+ * One controller, one request at a time. Transfers are polled, so a second
+ * thread arriving mid-transfer would read another's FIFO; the mutex is what
+ * makes that impossible rather than merely unlikely.
+ *
+ * A sector is read into a bounce buffer and copied, rather than straight
+ * into the caller's pages. The FIFO is read 32 bits at a time and the buffer
+ * a transfer lands in is not guaranteed to be aligned for that; one 512-byte
+ * copy against 128 uncached register reads is not a cost worth the risk of
+ * finding out where that assumption fails.
+ *
+ * dwmmc_part_lba and dwmmc_part_blocks are a window onto the card, so that
+ * the device is a partition rather than the whole disk. They come from boot
+ * arguments because there is no partition table reader here yet and, for a
+ * first root filesystem on real storage, there does not need to be: the PIT
+ * says where CACHE and SYSTEM start, and those numbers do not change.
+ */
+
+static lck_grp_t        *dwmmc_lck_grp;
+static lck_mtx_t        *dwmmc_lock;
+
+static vm_offset_t      dwmmc_dev_regs;         /* the controller, mapped */
+static uint32_t         dwmmc_dev_hcon;
+static int              dwmmc_cmajor = -1;
+static dev_t            dwmmc_bdev = NODEV;
+static void             *dwmmc_bdevb;
+static void             *dwmmc_cdevb;
+
+static uint64_t         dwmmc_bounce[DWMMC_SECTOR / 8];
+
+static int
+dwmmc_open(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *p)
+{
+	return (dwmmc_part_blocks != 0) ? 0 : ENXIO;
+}
+
+static int
+dwmmc_close(__unused dev_t dev, __unused int flags, __unused int devtype,
+    __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+dwmmc_size(__unused dev_t dev)
+{
+	return (dwmmc_part_blocks != 0) ? DWMMC_SECTOR : -1;
+}
+
+static void
+dwmmc_strategy(struct buf *bp)
+{
+	caddr_t dst;
+	uint64_t offset, length;
+	uint32_t sectors, i;
+	int error = 0;
+
+	if (dwmmc_part_blocks == 0) {
+		buf_seterror(bp, ENXIO);
+		buf_biodone(bp);
+		return;
+	}
+
+	if (!(buf_flags(bp) & B_READ)) {
+		buf_seterror(bp, EROFS);
+		buf_biodone(bp);
+		return;
+	}
+
+	buf_setresid(bp, buf_count(bp));
+
+	offset = (uint64_t)buf_blkno(bp) * DWMMC_SECTOR;
+	length = (uint64_t)dwmmc_part_blocks * DWMMC_SECTOR;
+
+	/*
+	 * Reading at the end is end-of-file and leaves resid == count;
+	 * reading past it is an error. memdev draws the line in the same
+	 * place and the filesystem layer expects it there.
+	 */
+	if (offset >= length) {
+		if (offset != length) {
+			buf_seterror(bp, EINVAL);
+		}
+		buf_biodone(bp);
+		return;
+	}
+	if (offset + buf_count(bp) > length) {
+		buf_setcount(bp, (uint32_t)(length - offset));
+	}
+
+	if (buf_count(bp) % DWMMC_SECTOR) {
+		buf_seterror(bp, EINVAL);
+		buf_biodone(bp);
+		return;
+	}
+
+	if (buf_map(bp, &dst)) {
+		buf_seterror(bp, ENOMEM);
+		buf_biodone(bp);
+		return;
+	}
+
+	sectors = buf_count(bp) / DWMMC_SECTOR;
+
+	lck_mtx_lock(dwmmc_lock);
+	for (i = 0; i < sectors; i++) {
+		error = dwmmc_read_block(dwmmc_dev_regs, dwmmc_dev_hcon,
+		    dwmmc_part_lba + (uint32_t)(offset / DWMMC_SECTOR) + i,
+		    dwmmc_bounce, 0);
+		if (error != 0) {
+			break;
+		}
+		memcpy(dst + (size_t)i * DWMMC_SECTOR, dwmmc_bounce,
+		    DWMMC_SECTOR);
+	}
+	lck_mtx_unlock(dwmmc_lock);
+
+	if (error != 0) {
+		buf_seterror(bp, EIO);
+		buf_setresid(bp, buf_count(bp) - (uint32_t)i * DWMMC_SECTOR);
+	} else {
+		buf_setresid(bp, 0);
+	}
+
+	buf_unmap(bp);
+	buf_biodone(bp);
+}
+
+static int
+dwmmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    struct proc *p)
+{
+	int error;
+
+	error = proc_suser(p);
+	if (error) {
+		return error;
+	}
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)(void *)data = DWMMC_SECTOR;
+		break;
+
+	/*
+	 * Answering this is not optional once DKIOCGETBLOCKSIZE is answered,
+	 * and the first attempt at this driver learned it the hard way:
+	 * spec_open()'s VBLK path reads the block size, sets it to 512,
+	 * reads the block count, and then sets the size back --
+	 *
+	 *     if (VNOP_IOCTL(vp, DKIOCSETBLOCKSIZE, &blksize, FWRITE, ctx))
+	 *             error = ENXIO;    "If it doesn't set back, we can't recover"
+	 *
+	 * -- so a driver that reports a size but refuses to set one cannot be
+	 * opened at all. The root mount died in bdevvp() with "open", several
+	 * layers away from the ioctl that caused it.
+	 *
+	 * 512 is the only size on offer, and both of spec_open()'s calls ask
+	 * for it, since 512 is what this reports. Anything else is refused
+	 * rather than silently ignored.
+	 */
+	case DKIOCSETBLOCKSIZE:
+		if (*(uint32_t *)(void *)data != DWMMC_SECTOR) {
+			return EINVAL;
+		}
+		break;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)(void *)data = dwmmc_part_blocks;
+		break;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)(void *)data = 0;
+		break;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+		*(uint64_t *)(void *)data = 32;
+		break;
+	default:
+		return ENOTTY;
+	}
+	return 0;
+}
+
+static int
+dwmmc_rw(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (uio_rw(uio) != UIO_READ) {
+		return EROFS;
+	}
+	return physio(dwmmc_strategy, NULL, dev, B_READ, minphys, uio,
+	           DWMMC_SECTOR);
+}
+
+static struct bdevsw dwmmc_bdevsw = {
+	/* open */ dwmmc_open,
+	/* close */ dwmmc_close,
+	/* strategy */ dwmmc_strategy,
+	/* ioctl */ dwmmc_ioctl,
+	/* dump */ eno_dump,
+	/* psize */ dwmmc_size,
+	/* flags */ D_DISK,
+};
+
+static struct cdevsw dwmmc_cdevsw = {
+	/* open */ dwmmc_open,
+	/* close */ dwmmc_close,
+	/* read */ dwmmc_rw,
+	/* write */ dwmmc_rw,
+	/* ioctl */ dwmmc_ioctl,
+	/* stop */ eno_stop,
+	/* reset */ eno_reset,
+	/* ttys */ NULL,
+	/* select */ eno_select,
+	/* mmap */ eno_mmap,
+	/* strategy */ eno_strat,
+	/* getc */ eno_getc,
+	/* putc */ eno_putc,
+	/* flags */ D_DISK,
+};
+
+/*
+ * IOFindBSDRoot() resolves rd=mdX by calling mdevlookup() before it tries
+ * any IOKit matching, because a memory device has no IOMedia to match
+ * against. Neither does this, for the same reason, so rd=mmc0 is answered
+ * the same way.
+ */
+dev_t dwmmc_lookup(void);
+
+dev_t
+dwmmc_lookup(void)
+{
+	return (dwmmc_part_blocks != 0) ? dwmmc_bdev : (dev_t)NODEV;
+}
+
+static void
+dwmmc_blockdev_init(vm_offset_t regs, uint32_t hcon)
+{
+	dwmmc_dev_regs = regs;
+	dwmmc_dev_hcon = hcon;
+
+	dwmmc_lck_grp = lck_grp_alloc_init("dwmmc", LCK_GRP_ATTR_NULL);
+	if (dwmmc_lck_grp == NULL) {
+		printf("dwmmc: no lock group\n");
+		return;
+	}
+	dwmmc_lock = lck_mtx_alloc_init(dwmmc_lck_grp, LCK_ATTR_NULL);
+	if (dwmmc_lock == NULL) {
+		printf("dwmmc: no lock\n");
+		return;
+	}
+
+	dwmmc_bmajor = bdevsw_add(-1, &dwmmc_bdevsw);
+	if (dwmmc_bmajor < 0) {
+		printf("dwmmc: bdevsw_add failed: %d\n", dwmmc_bmajor);
+		return;
+	}
+	dwmmc_cmajor = cdevsw_add_with_bdev(-1, &dwmmc_cdevsw, dwmmc_bmajor);
+	if (dwmmc_cmajor < 0) {
+		printf("dwmmc: cdevsw_add failed: %d\n", dwmmc_cmajor);
+		return;
+	}
+
+	dwmmc_bdev = makedev(dwmmc_bmajor, 0);
+	dwmmc_bdevb = devfs_make_node(dwmmc_bdev, DEVFS_BLOCK,
+	    UID_ROOT, GID_OPERATOR, 0600, "mmc0");
+	dwmmc_cdevb = devfs_make_node(makedev(dwmmc_cmajor, 0), DEVFS_CHAR,
+	    UID_ROOT, GID_OPERATOR, 0600, "rmmc0");
+	if (dwmmc_bdevb == NULL || dwmmc_cdevb == NULL) {
+		printf("dwmmc: devfs_make_node failed\n");
+		return;
+	}
+
+	printf("dwmmc: mmc0 is major %d, minor 0: LBA %u + %u sectors "
+	    "(%u MiB), read-only\n", dwmmc_bmajor, dwmmc_part_lba,
+	    dwmmc_part_blocks, dwmmc_part_blocks / 2048);
+	printf("dwmmc: boot with rd=mmc0 to use it as the root device\n");
+}
