+ */
+extern void     dwmmc_probe(void);
+
 /* hook called after root is mounted XXX temporary hack */
 void (*mountroot_post_hook)(void);
 void (*unmountroot_pre_hook)(void);
@@ -852,6 +858,13 @@
 	bsd_init_kprintf("calling bsd_autoconf\n");
 	bsd_autoconf();
 
+	/*
+	 * Straight after autoconf, which is where devices come up, and a long
+	 * way before the root mount this is meant to end up serving.
+	 */
+	bsd_init_kprintf("calling dwmmc_probe\n");
+	dwmmc_probe();
+
 	bsd_init_kprintf("calling os_reason_init\n");
 	os_reason_init();
 
