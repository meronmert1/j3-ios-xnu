osfmk/arm64/monotonic.h defines the core counter layout (MT_NDEVS,
MT_CORE_CYCLES, MT_CORE_INSTRS, MT_CORE_NFIXED) inside #if MONOTONIC and then
#if KERNEL_PRIVATE. The exported copy of machine/monotonic.h is run through
unifdef, which drops the KERNEL_PRIVATE section but keeps the
MACH_KERNEL_PRIVATE code that reads the constants, so every consumer fails
with "use of undeclared identifier 'MT_CORE_NFIXED'".

Publish the four constants ahead of both guards. They describe the hardware,
not a build configuration or a privilege level, and C permits the identical
repeat definitions that follow.

--- a/osfmk/arm64/monotonic.h
+++ b/osfmk/arm64/monotonic.h
@@ -30,6 +30,19 @@
 
 #include <sys/cdefs.h>
 
+/*
+ * How many counters a core has is a property of the hardware, not of
+ * the build configuration or of the caller's privilege. Keep these out
+ * of both guards below: the exported copy of machine/monotonic.h is run
+ * through unifdef, which drops the KERNEL_PRIVATE section while leaving
+ * the MACH_KERNEL_PRIVATE code that reads them. The definitions inside
+ * repeat these verbatim, which C permits.
+ */
+#define MT_NDEVS 1
+#define MT_CORE_CYCLES 0
+#define MT_CORE_INSTRS 1
+#define MT_CORE_NFIXED 2
+
 #if MONOTONIC
 
 #include <pexpert/arm64/board_config.h>
