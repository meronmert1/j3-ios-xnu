+/*
+ * Bring-up: whether every dying process says why.
+ *
+ * launchd already prints an exit reason, but only for pid 1, and only on
+ * the way to a panic. Everything else dies silently: the console shows
+ * "Process[1017] crashed: SpringBoard. Too many corpses being created.",
+ * which is the corpse allocator giving up rather than the reason the
+ * process died, and says nothing about why there were corpses to make.
+ *
+ * The reason is already attached to the process and already has a string
+ * description sitting in its kcdata; launchd_exit_reason_get_string_desc()
+ * pulls it out. Namespace 6 is dyld, whose codes name a missing dylib or a
+ * missing symbol and whose description names which one, and that is the
+ * difference between a daemon that cannot find a library and one that
+ * segfaults. One line per dying process, which on a boot that is working
+ * is nearly none.
+ *
+ * exittrace=0 turns it off.
+ */
+static int exit_trace = -1;
+
+/*
+ * exitbt: the dying process's own backtrace, on the console.
+ *
+ * The line above says a process died of a signal and no more. What it died
+ * of is in its crash report, and on a handset that is losing backboardd and
+ * SpringBoard in a loop there is no crash report to read: the kernel allows
+ * five corpses in flight, the loop keeps all five, ReportCrash only ever
+ * sees a corpse, and so it writes nothing. The reports that do survive are
+ * from whichever boot was quiet enough, which is never the one being
+ * debugged.
+ *
+ * The backtrace does not need any of that. The thread that took the signal
+ * is still here, its user state is saved where the kernel can read it, and
+ * on arm64 the frame chain is two words per frame -- [fp] is the next frame
+ * and [fp + 8] the return address. Walking it with copyin, which fails
+ * safely on a bad address, gives the same list of addresses that a crash
+ * report prints as "Last Exception Backtrace", one line, while it happens.
+ *
+ * It is the addresses and not the symbols: nothing here knows where the
+ * binary was loaded. That is enough to work with, because the distance
+ * between two frames in the same binary survives the slide -- the two
+ * backboardd frames of one assertion sit 0x163A0 apart in every report of
+ * it, whatever the slide was that boot.
+ *
+ * exitbt=0 turns it off. exitbtname=backboardd narrows it to one process,
+ * which on a console with no scrollback is the difference between reading
+ * the line and watching it go past.
+ */
+static int exit_bt = -1;
+static char exit_bt_name[32];
+
+#if defined(__arm64__)
+
+#define EXIT_BT_FRAMES  12
+
+extern arm_saved_state_t *find_user_regs(thread_t);
+
+static void
+exit_user_backtrace(proc_t p, int sig)
+{
+	arm_saved_state_t *regs;
+	user_addr_t fp, next;
+	uint64_t frame[2];
+	char line[256];
+	size_t off;
+	int i, wrote;
+
+	regs = find_user_regs(current_thread());
+	if (regs == NULL) {
+		return;
+	}
+
+	wrote = snprintf(line, sizeof(line),
+	    "crash: %s[%d] sig %d pc 0x%llx lr 0x%llx bt",
+	    p->p_comm, p->p_pid, sig,
+	    (unsigned long long)get_saved_state_pc(regs),
+	    (unsigned long long)get_saved_state_lr(regs));
+	if (wrote < 0 || (size_t)wrote >= sizeof(line)) {
+		return;
+	}
+	off = (size_t)wrote;
+
+	fp = (user_addr_t)get_saved_state_fp(regs);
+	for (i = 0; i < EXIT_BT_FRAMES; i++) {
+		if (fp == 0 || (fp & 7) != 0) {
+			break;
+		}
+		if (copyin(fp, (char *)frame, sizeof(frame)) != 0) {
+			break;
+		}
+		if (frame[1] == 0) {
+			break;
+		}
+		wrote = snprintf(line + off, sizeof(line) - off, " 0x%llx",
+		    (unsigned long long)frame[1]);
+		if (wrote < 0 || (size_t)wrote >= sizeof(line) - off) {
+			break;
+		}
+		off += (size_t)wrote;
+
+		/*
+		 * The chain has to climb. A frame pointer that does not is a
+		 * loop or a corrupt stack, and either way there is nothing
+		 * further up worth printing.
+		 */
+		next = (user_addr_t)frame[0];
+		if (next <= fp) {
+			break;
+		}
+		fp = next;
+	}
+
+	printf("%s\n", line);
+}
+
+#else  /* !__arm64__ */
+
+static void
+exit_user_backtrace(__unused proc_t p, __unused int sig)
+{
+}
+
+#endif /* __arm64__ */
