--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -198,6 +198,78 @@
 extern uint32_t __thread_starts_sect_start[] __asm("section$start$__TEXT$__thread_starts");
 extern uint32_t __thread_starts_sect_end[]   __asm("section$end$__TEXT$__thread_starts");
 
+
+/*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * The framebuffer has to be reached three different ways over the course of
+ * the boot, so the address lives in j3_fb_addr and arm_vm_init moves it along
+ * as each mapping is retired:
+ *
+ *   1. physical, while the V=P bootstrap mapping in TTBR0 is live -- up to
+ *      the set_mmu_ttb(invalid_ttep) inside arm_vm_init;
+ *   2. phystokv(), while TTBR1 still holds the bootstrap tables built by
+ *      start.s -- up to set_mmu_ttb_alternate(cpu_ttep);
+ *   3. whatever ml_io_map() hands back, once pmap_bootstrap() has run and
+ *      virtual_space_start exists.
+ *
+ * Between (2) and (3) there is no mapping at all, which is why no band can be
+ * placed over the table switch itself.
+ *
+ * Every mapping but the last is write-back, so the pixels have to be pushed
+ * out by hand or the band never reaches the panel. The flush is harmless on
+ * the device-memory mapping from ml_io_map().
+ *
+ * Two rows of bands, so that neither group grows long enough to be miscounted
+ * from a photograph: j3_mark() draws near the bottom of the panel and
+ * j3_mark2() near the top. Nothing is static: osfmk/arm64/arm_vm_init.c marks
+ * its way through arm_vm_init() with the same helpers. Keep the geometry in
+ * step with the J3_MARK macro in osfmk/arm64/start.s.
+ */
+#define J3_FB_BASE      0x67000000UL
+#define J3_FB_STRIDE    2880UL
+#define J3_FB_HEIGHT    1280UL
+#define J3_FB_SIZE      (J3_FB_STRIDE * J3_FB_HEIGHT)
+#define J3_MARK_ROW0    950UL
+#define J3_MARK2_ROW0   700UL
+#define J3_MARK_PITCH   24UL
+#define J3_MARK_HEIGHT  16U
+#define J3_MARK_WIDTH   720U
+
+uintptr_t j3_fb_addr = (uintptr_t)J3_FB_BASE;
+
+void j3_mark(unsigned slot, uint32_t colour);
+void j3_mark2(unsigned slot, uint32_t colour);
+
+static void
+j3_band(unsigned long row0, unsigned slot, uint32_t colour)
+{
+	volatile uint32_t *band = (volatile uint32_t *)
+	    (j3_fb_addr + (row0 + slot * J3_MARK_PITCH) * J3_FB_STRIDE);
+	const unsigned npx = J3_MARK_WIDTH * J3_MARK_HEIGHT;
+
+	for (unsigned i = 0; i < npx; i++) {
+		band[i] = colour;
+	}
+	__asm__ volatile ("dsb sy");
+	for (unsigned i = 0; i < npx * 4u; i += 64u) {
+		__asm__ volatile ("dc cvac, %0" :: "r"((uintptr_t)band + i) : "memory");
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+void
+j3_mark(unsigned slot, uint32_t colour)
+{
+	j3_band(J3_MARK_ROW0, slot, colour);
+}
+
+void
+j3_mark2(unsigned slot, uint32_t colour)
+{
+	j3_band(J3_MARK2_ROW0, slot, colour);
+}
+
