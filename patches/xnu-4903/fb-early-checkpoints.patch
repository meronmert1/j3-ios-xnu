@@ -1513,6 +1525,9 @@
 
 	arm_vm_prot_init(args);
 
+	/* Bring-up: arm_vm_prot_init returned. */
+	j3_mark(5, 0x00FF00FFu);        /* magenta */
+
 
 	/*
 	 * Initialize the page tables for the low globals:
@@ -1566,6 +1581,13 @@
 	kasan_init();
 #endif
 
+	/*
+	 * Bring-up: the last band possible. set_mmu_ttb below retires the V=P
+	 * mapping every band is written through, and a band placed after it
+	 * would fault and take down a kernel that was otherwise fine.
+	 */
+	j3_mark(6, 0x0000FFFFu);        /* cyan */
+
 	set_tbi();
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
