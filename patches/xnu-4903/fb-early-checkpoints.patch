Draw progress bands on the framebuffer through early arm64 boot.

On a board with no serial port nothing the kernel does before
PE_create_console is visible, and that is a long way in. Until then a failure
is a frozen screen and nothing else -- made worse by start_first_cpu setting
VBAR_EL1 to LowExceptionVectorBase almost immediately, which catches an early
fault in a spin loop, so the machine does not even reset to say that something
went wrong.

Successive rounds have walked the failure down from "somewhere in the kernel"
to inside lck_mod_init(), so the bands now sit between that function's own
steps:

    0  green    first instruction of start_first_cpu
    1  white    lck_mod_init() was entered
    2  red      the boot-arg was read and the group queue initialised
    3  blue     the compat group was zeroed, named and given its attributes
    4  yellow   the group is on the queue
    5  magenta  both attribute defaults are set
    6  cyan     lck_mtx_init_ext() returned; lck_mod_init() is complete

Seven, not more, and in six clearly different colours: the count is read off a
photograph of a phone screen, and a dozen similar bands is a measurement that
cannot be trusted. Slot 0 is a known-good anchor confirming the handoff and
the MMU still work.

What makes this worth instrumenting at all is that lck_mod_init() is pure
software -- queue manipulation, a bzero, a strncpy, two attribute defaults and
a mutex initialiser -- with nothing in it that should care what board it is
running on. Something in there does, and narrowing it to one statement is
cheaper than reasoning about which.

The helper lives in osfmk/arm/arm_init.c and is deliberately not static, so
osfmk/kern/locks.c can use the same code and the same geometry.

Two things are needed to make any band after the MMU is enabled work, and both
are easy to miss. The framebuffer has to stay reachable once translation is
on: it is a carveout immediately above the memory the kernel manages, so it
falls outside the V=P bootstrap mapping, which covers exactly memSize bytes,
and a few extra L2 entries bring it back in. And the pixels have to be flushed
-- ARM_TTE_BOOT_BLOCK maps with CACHE_ATTRINDX_WRITEBACK, so the band would
otherwise sit in the cache and never reach the panel, missing even though the
code ran, which is precisely the wrong answer to get from a test like this.
Before the MMU is enabled the access is Device and the maintenance is a no-op,
so the same code is correct either side.

Every band reaches the framebuffer through that V=P bootstrap mapping, so all
of this has to stay ahead of arm_vm_init, which replaces it. Checkpoints past
that point need a mapping of their own.

x6 through x9 are the only registers the assembly macro touches, and x0, which
holds the boot_args pointer at slot 0, is deliberately left alone. The macro
follows this file's own conventions -- .macro with positional $0/$1 and
.endmacro -- rather than the GNU spellings, which the Apple assembler this is
built with does not use.

The geometry constants describe this board's display; another board needs
those changed and nothing else.

This is a debugging aid, not a fix. Drop it once the kernel reaches its own
console.

--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -85,6 +85,53 @@
 .endmacro
 
 /*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * Clobbers x6-x9 and nothing else.
+ */
+#define J3_FB_BASE	0x67000000
+#define J3_FB_STRIDE	2880
+#define J3_MARK_ROW0	1100
+#define J3_MARK_PITCH	24
+#define J3_MARK_HEIGHT	16
+#define J3_MARK_WIDTH	720
+
+#define J3_MARK_OFF(slot) \
+	((J3_MARK_ROW0 + (slot) * J3_MARK_PITCH) * J3_FB_STRIDE)
+#define J3_MARK_BYTES	(J3_MARK_WIDTH * J3_MARK_HEIGHT * 4)
+
+.macro J3_MARK
+	movz	x6, #((J3_FB_BASE) >> 16), lsl #16
+	movz	x7, #(J3_MARK_OFF($0) & 0xFFFF)
+	movk	x7, #((J3_MARK_OFF($0) >> 16) & 0xFFFF), lsl #16
+	add		x6, x6, x7
+	mov		x9, x6
+	movz	w7, #(($1) & 0xFFFF)
+	movk	w7, #((($1) >> 16) & 0xFFFF), lsl #16
+	mov		x8, #(J3_MARK_WIDTH * J3_MARK_HEIGHT)
+9991:
+	str		w7, [x6], #4
+	subs	x8, x8, #1
+	b.ne	9991b
+	/*
+	 * Once the MMU is on this address is reached through a bootstrap block
+	 * entry, and ARM_TTE_BOOT_BLOCK is CACHE_ATTRINDX_WRITEBACK, so the
+	 * pixels would sit in the cache and never reach the panel. Push them
+	 * out. Harmless before the MMU is enabled, where the access is Device.
+	 */
+	dsb		sy
+	mov		x8, #(J3_MARK_BYTES / 64)
+9992:
+	dc		cvac, x9
+	add		x9, x9, #64
+	subs	x8, x8, #1
+	b.ne	9992b
+	dsb		sy
+.endmacro
+
+#define J3_MARK_GREEN	0x0000FF00
+
+/*
  * Checks the reset handler for global and CPU-specific reset-assist functions,
  * then jumps to the reset handler with boot args and cpu data. This is copied
  * to the first physical page during CPU bootstrap (see cpu.c).
@@ -449,6 +496,9 @@
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+	/* Bring-up: the kernel is executing. x0 still holds boot_args. */
+	J3_MARK 0, J3_MARK_GREEN
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -593,6 +643,12 @@
 	 * x5 - total number of L2 entries to allocate
 	 */
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
+	/*
+	 * Bring-up: a few extra L2 entries so the V=P mapping reaches past the
+	 * end of kernel-managed memory and still covers the framebuffer, which
+	 * is a carveout just above it. arm_vm_init replaces this mapping later.
+	 */
+	add		x5, x5, #8
 	/* create_bootstrap_mapping(vbase, pbase, num_ents, L1 table, freeptr) */
 	create_bootstrap_mapping x0,  x4,  x5, x1, x2, x6, x10, x11, x12, x13
 
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -198,6 +198,45 @@
 extern uint32_t __thread_starts_sect_start[] __asm("section$start$__TEXT$__thread_starts");
 extern uint32_t __thread_starts_sect_end[]   __asm("section$end$__TEXT$__thread_starts");
 
+
+/*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * The framebuffer is still reachable at its physical address through the V=P
+ * bootstrap table in TTBR0, which arm_vm_init has not replaced yet, and that
+ * mapping is write-back, so the pixels have to be pushed out by hand or the
+ * band never reaches the panel.
+ *
+ * Not static: osfmk/kern/locks.c marks its way through lck_mod_init() with
+ * the same helper. Keep the geometry in step with the J3_MARK macro in
+ * osfmk/arm64/start.s.
+ */
+#define J3_FB_BASE      0x67000000UL
+#define J3_FB_STRIDE    2880UL
+#define J3_MARK_ROW0    1100UL
+#define J3_MARK_PITCH   24UL
+#define J3_MARK_HEIGHT  16U
+#define J3_MARK_WIDTH   720U
+
+void j3_mark(unsigned slot, uint32_t colour);
+
+void
+j3_mark(unsigned slot, uint32_t colour)
+{
+	volatile uint32_t *band = (volatile uint32_t *)(uintptr_t)
+	    (J3_FB_BASE + (J3_MARK_ROW0 + slot * J3_MARK_PITCH) * J3_FB_STRIDE);
+	const unsigned npx = J3_MARK_WIDTH * J3_MARK_HEIGHT;
+
+	for (unsigned i = 0; i < npx; i++) {
+		band[i] = colour;
+	}
+	__asm__ volatile ("dsb sy");
+	for (unsigned i = 0; i < npx * 4u; i += 64u) {
+		__asm__ volatile ("dc cvac, %0" :: "r"((uintptr_t)band + i) : "memory");
+	}
+	__asm__ volatile ("dsb sy");
+}
+
 void
 arm_init(
 	boot_args       *args)
--- a/osfmk/kern/locks.c
+++ b/osfmk/kern/locks.c
@@ -139,10 +139,16 @@
  * Routine:	lck_mod_init
  */
 
+/* Bring-up: see the fb-early-checkpoints patch. Defined in osfmk/arm/arm_init.c. */
+extern void j3_mark(unsigned slot, uint32_t colour);
+
 void
 lck_mod_init(
 	void)
 {
+	/* Bring-up: lck_mod_init was entered. */
+	j3_mark(1, 0x00FFFFFFu);        /* white */
+
 	/*
 	 * Obtain "lcks" options:this currently controls lock statistics
 	 */
@@ -159,6 +165,9 @@
 
 	queue_init(&lck_grp_queue);
 
+	/* Bring-up: boot-arg read and the group queue is initialised. */
+	j3_mark(2, 0x00FF0000u);        /* red */
+
 	/*
 	 * Need to bootstrap the LockCompatGroup instead of calling lck_grp_init() here. This avoids
 	 * grabbing the lck_grp_lock before it is initialized.
@@ -175,15 +184,27 @@
 		LockCompatGroup.lck_grp_attr |= LCK_GRP_ATTR_TIME_STAT;
 	}
 
+	/* Bring-up: the compat group was zeroed, named and given its attrs. */
+	j3_mark(3, 0x000080FFu);        /* blue */
+
 	LockCompatGroup.lck_grp_refcnt = 1;
 
 	enqueue_tail(&lck_grp_queue, (queue_entry_t)&LockCompatGroup);
 	lck_grp_cnt = 1;
 
+	/* Bring-up: the group is on the queue. */
+	j3_mark(4, 0x00FFFF00u);        /* yellow */
+
 	lck_grp_attr_setdefault(&LockDefaultGroupAttr);
 	lck_attr_setdefault(&LockDefaultLckAttr);
 
+	/* Bring-up: both attribute defaults are set. */
+	j3_mark(5, 0x00FF00FFu);        /* magenta */
+
 	lck_mtx_init_ext(&lck_grp_lock, &lck_grp_lock_ext, &LockCompatGroup, &LockDefaultLckAttr);
+
+	/* Bring-up: lck_mod_init is complete. */
+	j3_mark(6, 0x0000FFFFu);        /* cyan */
 }
 
