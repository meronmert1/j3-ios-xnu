Draw progress bands on the framebuffer, through to the kernel's own console.

On a board with no serial port nothing the kernel does before
PE_create_console is visible, and that is a long way in. Until then a failure
is a frozen screen and nothing else -- made worse by start_first_cpu setting
VBAR_EL1 to LowExceptionVectorBase almost immediately, which catches an early
fault in a spin loop, so the machine does not even reset to say that something
went wrong.

The bands now reach PE_create_console itself, which is as far as this
technique needs to go:

    0  green    first instruction of start_first_cpu
    1  white    about to call arm_vm_init()
    2  red      arm_vm_init() returned; the real page tables are live
    3  blue     printf_init() and panic_init() returned
    4  yellow   PE_init_kprintf() returned
    5  magenta  about to call PE_create_console()
    6  cyan     PE_create_console() returned

Seven, in six clearly different colours: the count is read off a photograph of
a phone screen, so a dozen similar bands is a measurement that cannot be
trusted. Slots 0 and 1 are anchors over ground already known to work.

The important change is that a band is now written two different ways. Before
arm_vm_init the framebuffer's physical address still resolves through the V=P
bootstrap mapping in TTBR0, and that mapping is write-back, so the pixels have
to be flushed by hand or the band never reaches the panel. arm_vm_init
replaces that mapping, and a band written to the physical address afterwards
does not merely fail to appear -- it faults, and takes down a kernel that was
otherwise fine. That is a worse outcome than seeing nothing, because the
instrument becomes the fault. Everything after arm_vm_init therefore asks
ml_io_map for a real mapping, which hands back device memory and needs no
flushing.

The framebuffer also has to be reachable at all before arm_vm_init: it is a
carveout immediately above the memory the kernel manages, so it falls outside
the V=P bootstrap mapping, which covers exactly memSize bytes. A few extra L2
entries bring it back in.

x6 through x9 are the only registers the assembly macro touches, and x0, which
holds the boot_args pointer at slot 0, is deliberately left alone. The macro
follows this file's own conventions -- .macro with positional $0/$1 and
.endmacro -- rather than the GNU spellings, which the Apple assembler this is
built with does not use.

Reaching slot 6 is the end of the exercise: from there the kernel can write to
the screen itself, and the bands have nothing left to say. Note that
PE_create_console may well clear the framebuffer, so the bands disappearing is
a success, not a failure.

The geometry constants describe this board's display; another board needs
those changed and nothing else.

This is a debugging aid, not a fix. Drop it once the kernel reaches its own
console.

--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -85,6 +85,47 @@
 .endmacro
 
 /*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * Clobbers x6-x9 and nothing else.
+ */
+#define J3_FB_BASE	0x67000000
+#define J3_FB_STRIDE	2880
+#define J3_MARK_ROW0	950
+#define J3_MARK_PITCH	24
+#define J3_MARK_HEIGHT	16
+#define J3_MARK_WIDTH	720
+
+#define J3_MARK_OFF(slot) \
+	((J3_MARK_ROW0 + (slot) * J3_MARK_PITCH) * J3_FB_STRIDE)
+#define J3_MARK_BYTES	(J3_MARK_WIDTH * J3_MARK_HEIGHT * 4)
+
+.macro J3_MARK
+	movz	x6, #((J3_FB_BASE) >> 16), lsl #16
+	movz	x7, #(J3_MARK_OFF($0) & 0xFFFF)
+	movk	x7, #((J3_MARK_OFF($0) >> 16) & 0xFFFF), lsl #16
+	add		x6, x6, x7
+	mov		x9, x6
+	movz	w7, #(($1) & 0xFFFF)
+	movk	w7, #((($1) >> 16) & 0xFFFF), lsl #16
+	mov		x8, #(J3_MARK_WIDTH * J3_MARK_HEIGHT)
+9991:
+	str		w7, [x6], #4
+	subs	x8, x8, #1
+	b.ne	9991b
+	dsb		sy
+	mov		x8, #(J3_MARK_BYTES / 64)
+9992:
+	dc		cvac, x9
+	add		x9, x9, #64
+	subs	x8, x8, #1
+	b.ne	9992b
+	dsb		sy
+.endmacro
+
+#define J3_MARK_GREEN	0x0000FF00
+
+/*
  * Checks the reset handler for global and CPU-specific reset-assist functions,
  * then jumps to the reset handler with boot args and cpu data. This is copied
  * to the first physical page during CPU bootstrap (see cpu.c).
@@ -449,6 +490,9 @@
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+	/* Bring-up: the kernel is executing. x0 still holds boot_args. */
+	J3_MARK 0, J3_MARK_GREEN
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -593,6 +637,13 @@
 	 * x5 - total number of L2 entries to allocate
 	 */
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
+	/*
+	 * Bring-up: a few extra L2 entries so the V=P mapping reaches past the
+	 * end of kernel-managed memory and still covers the framebuffer, which
+	 * is a carveout just above it. arm_vm_init replaces this mapping later,
+	 * which is why the later bands go through ml_io_map instead.
+	 */
+	add		x5, x5, #8
 	/* create_bootstrap_mapping(vbase, pbase, num_ents, L1 table, freeptr) */
 	create_bootstrap_mapping x0,  x4,  x5, x1, x2, x6, x10, x11, x12, x13
 
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -198,6 +198,71 @@
 extern uint32_t __thread_starts_sect_start[] __asm("section$start$__TEXT$__thread_starts");
 extern uint32_t __thread_starts_sect_end[]   __asm("section$end$__TEXT$__thread_starts");
 
+
+/*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * Two versions, because the framebuffer is reached two different ways either
+ * side of arm_vm_init. Keep the geometry in step with the J3_MARK macro in
+ * osfmk/arm64/start.s.
+ */
+#define J3_FB_BASE      0x67000000UL
+#define J3_FB_STRIDE    2880UL
+#define J3_MARK_ROW0    950UL
+#define J3_MARK_PITCH   24UL
+#define J3_MARK_HEIGHT  16U
+#define J3_MARK_WIDTH   720U
+#define J3_FB_SPAN      (1280UL * J3_FB_STRIDE)
+
+/*
+ * Before arm_vm_init: the physical address still resolves through the V=P
+ * bootstrap table in TTBR0, and that mapping is write-back, so the pixels
+ * have to be pushed out by hand or the band never reaches the panel.
+ */
+static void
+j3_mark(unsigned slot, uint32_t colour)
+{
+	volatile uint32_t *band = (volatile uint32_t *)(uintptr_t)
+	    (J3_FB_BASE + (J3_MARK_ROW0 + slot * J3_MARK_PITCH) * J3_FB_STRIDE);
+	const unsigned npx = J3_MARK_WIDTH * J3_MARK_HEIGHT;
+
+	for (unsigned i = 0; i < npx; i++) {
+		band[i] = colour;
+	}
+	__asm__ volatile ("dsb sy");
+	for (unsigned i = 0; i < npx * 4u; i += 64u) {
+		__asm__ volatile ("dc cvac, %0" :: "r"((uintptr_t)band + i) : "memory");
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+/*
+ * After arm_vm_init: the V=P mapping is gone, so writing the physical address
+ * would fault -- and a band placed there would take down a kernel that was
+ * otherwise fine, which is worse than seeing nothing. Ask for a real mapping
+ * instead. ml_io_map hands back device memory, so no flushing is needed.
+ */
+static volatile uint32_t *j3_io_fb;
+
+static void
+j3_mark_io(unsigned slot, uint32_t colour)
+{
+	if (j3_io_fb == NULL) {
+		j3_io_fb = (volatile uint32_t *)ml_io_map(J3_FB_BASE, J3_FB_SPAN);
+		if (j3_io_fb == NULL) {
+			return;
+		}
+	}
+
+	volatile uint32_t *band = j3_io_fb +
+	    (J3_MARK_ROW0 + slot * J3_MARK_PITCH) * J3_FB_STRIDE / 4;
+
+	for (unsigned i = 0; i < J3_MARK_WIDTH * J3_MARK_HEIGHT; i++) {
+		band[i] = colour;
+	}
+	__asm__ volatile ("dsb sy");
+}
+
 void
 arm_init(
 	boot_args       *args)
@@ -381,8 +446,14 @@
 	__builtin_arm_wsr("pan", 1);
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
+	/* Bring-up: everything up to here is confirmed working. */
+	j3_mark(1, 0x00FFFFFFu);        /* white */
+
 	arm_vm_init(xmaxmem, args);
 
+	/* Bring-up: arm_vm_init returned; the real page tables are live. */
+	j3_mark_io(2, 0x00FF0000u);     /* red */
+
 	uint32_t debugmode;
 	if (PE_parse_boot_argn("debug", &debugmode, sizeof(debugmode)) &&
 	    debugmode) {
@@ -391,6 +462,9 @@
 
 	printf_init();
 	panic_init();
+
+	/* Bring-up: panic_init() returned. */
+	j3_mark_io(3, 0x000080FFu);     /* blue */
 #if __arm64__
 	/* Enable asynchronous exceptions */
 	__builtin_arm_wsr("DAIFClr", DAIFSC_ASYNCF);
@@ -404,6 +478,9 @@
 	/* setup debugging output if one has been chosen */
 	PE_init_kprintf(FALSE);
 
+	/* Bring-up: PE_init_kprintf(FALSE) returned. */
+	j3_mark_io(4, 0x00FFFF00u);     /* yellow */
+
 	kprintf("kprintf initialized\n");
 
 	serialmode = 0;                                                      /* Assume normal keyboard and console */
@@ -430,8 +507,14 @@
 		(void)switch_to_serial_console(); /* Switch into serial mode */
 		disableConsoleOutput = FALSE;     /* Allow printfs to happen */
 	}
+	/* Bring-up: about to bring up the kernel's own console. */
+	j3_mark_io(5, 0x00FF00FFu);     /* magenta */
+
 	PE_create_console();
 
+	/* Bring-up: PE_create_console returned. */
+	j3_mark_io(6, 0x0000FFFFu);     /* cyan */
+
 	/* setup console output */
 	PE_init_printf(FALSE);
 
