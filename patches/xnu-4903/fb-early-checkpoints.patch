Draw progress bands on the framebuffer, through every mapping the boot uses.

On a board with no serial port nothing the kernel does before PE_create_console
is visible, and that is a long way in. Until then a failure is a frozen screen
and nothing else -- made worse by start_first_cpu setting VBAR_EL1 to
LowExceptionVectorBase almost immediately, which catches an early fault in a
spin loop, so the machine does not even reset to say that something went wrong.

The hard part is that the framebuffer has to be reached three different ways
over the course of the boot, because arm_vm_init retires one mapping after
another underneath it:

  1. physically, while the V=P bootstrap mapping in TTBR0 is live -- up to
     set_mmu_ttb(invalid_ttep);
  2. through phystokv(), while TTBR1 still holds the bootstrap tables built by
     start.s -- up to set_mmu_ttb_alternate(cpu_ttep);
  3. through whatever ml_io_map() returns, once pmap_bootstrap() has set
     virtual_space_start. This is the same call initialize_screen() makes for
     the console proper, and the L3 tables it needs are the ones arm_vm_init
     allocates for "2MB + FrameBuffer size + 10MB for each 256MB segment".

So the address lives in j3_fb_addr and arm_vm_init moves it along at each of
those points. Between (2) and (3) there is no mapping at all, and that gap --
the table switch and pmap_bootstrap -- is the one stretch of the boot that
cannot be marked.

(2) also requires both bootstrap mappings in start.s to be widened, not just
the V=P one. The framebuffer is a carveout immediately above the memory the
kernel manages, so it falls outside a mapping that covers exactly memSize
bytes; eight more L2 entries bring it back in. They are spare slots in table
pages that are allocated anyway, and the whole set is abandoned at
set_mmu_ttb_alternate.

The bands are drawn in two groups so that neither grows long enough to be
miscounted from a photograph -- which is how they are read on a board like
this. The lower group runs while the kernel is still building its address
space:

    0  green    first instruction of start_first_cpu
    1  white    about to call arm_vm_init()
    2  red      the first "Unsupported memory configuration" panic was cleared
    3  magenta  arm_vm_prot_init() returned
    4  cyan     everything is built; about to retire the V=P mapping

and the upper group (row 700, clear of the booter banner) runs from there to the kernel's own console:

    0  green    arm_vm_physmap_init() returned
    1  white    arm_vm_init() returned; framebuffer re-mapped via ml_io_map()
    2  red      patch_low_glo, printf_init and panic_init are done
    3  magenta  PE_consistent_debug_inherit and PE_init_kprintf returned
    4  cyan     about to call PE_create_console()

Upper cyan is the end of the instrument: PE_create_console() clears the screen
and the kernel starts printing for itself, so a panel still showing bands means
it did not get that far.

Two bands from an earlier round are gone. They sat inside
"#if defined(KERNEL_INTEGRITY_KTRR)", which this board does not define, so they
were never compiled and only confused the numbering.

The pixels have to be flushed by hand for (1) and (2), because those mappings
are write-back; the flush is left in place for (3), where the mapping is device
memory and it does nothing.

x6 through x9 are the only registers the assembly macro touches, and x0, which
holds the boot_args pointer at slot 0, is deliberately left alone. The macro
follows this file's own conventions -- .macro with positional $0/$1 and
.endmacro -- rather than the GNU spellings, which the Apple assembler this is
built with does not use.

The helpers live in osfmk/arm/arm_init.c and are not static so that
osfmk/arm64/arm_vm_init.c can use the same code and the same geometry. The
geometry constants describe this board's display; another board needs those
changed and nothing else.

This is a debugging aid, not a fix. Drop it once the kernel reaches its own
console.

--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -85,6 +85,47 @@
 .endmacro
 
 /*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * Clobbers x6-x9 and nothing else.
+ */
+#define J3_FB_BASE	0x67000000
+#define J3_FB_STRIDE	2880
+#define J3_MARK_ROW0	950
+#define J3_MARK_PITCH	24
+#define J3_MARK_HEIGHT	16
+#define J3_MARK_WIDTH	720
+
+#define J3_MARK_OFF(slot) \
+	((J3_MARK_ROW0 + (slot) * J3_MARK_PITCH) * J3_FB_STRIDE)
+#define J3_MARK_BYTES	(J3_MARK_WIDTH * J3_MARK_HEIGHT * 4)
+
+.macro J3_MARK
+	movz	x6, #((J3_FB_BASE) >> 16), lsl #16
+	movz	x7, #(J3_MARK_OFF($0) & 0xFFFF)
+	movk	x7, #((J3_MARK_OFF($0) >> 16) & 0xFFFF), lsl #16
+	add		x6, x6, x7
+	mov		x9, x6
+	movz	w7, #(($1) & 0xFFFF)
+	movk	w7, #((($1) >> 16) & 0xFFFF), lsl #16
+	mov		x8, #(J3_MARK_WIDTH * J3_MARK_HEIGHT)
+9991:
+	str		w7, [x6], #4
+	subs	x8, x8, #1
+	b.ne	9991b
+	dsb		sy
+	mov		x8, #(J3_MARK_BYTES / 64)
+9992:
+	dc		cvac, x9
+	add		x9, x9, #64
+	subs	x8, x8, #1
+	b.ne	9992b
+	dsb		sy
+.endmacro
+
+#define J3_MARK_GREEN	0x0000FF00
+
+/*
  * Checks the reset handler for global and CPU-specific reset-assist functions,
  * then jumps to the reset handler with boot args and cpu data. This is copied
  * to the first physical page during CPU bootstrap (see cpu.c).
@@ -449,6 +490,9 @@
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+	/* Bring-up: the kernel is executing. x0 still holds boot_args. */
+	J3_MARK 0, J3_MARK_GREEN
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -593,11 +637,23 @@
 	 * x5 - total number of L2 entries to allocate
 	 */
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
+	/*
+	 * Bring-up: a few extra L2 entries so the mapping reaches past the end
+	 * of kernel-managed memory and still covers the framebuffer, which is a
+	 * carveout just above it. Both bootstrap mappings are widened, not just
+	 * this one: arm_vm_init draws its later checkpoints through TTBR1 after
+	 * it has retired the V=P mapping in TTBR0, so the KVA table below needs
+	 * the same reach. The entries are spare table slots in pages that are
+	 * allocated anyway, and the whole set is abandoned at
+	 * set_mmu_ttb_alternate.
+	 */
+	add		x5, x5, #8
 	/* create_bootstrap_mapping(vbase, pbase, num_ents, L1 table, freeptr) */
 	create_bootstrap_mapping x0,  x4,  x5, x1, x2, x6, x10, x11, x12, x13
 
 	/* Setup the KVA bootstrap mapping */
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
+	add		x5, x5, #8
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
 	/* Ensure TTEs are visible */
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -198,6 +198,78 @@
 extern uint32_t __thread_starts_sect_start[] __asm("section$start$__TEXT$__thread_starts");
 extern uint32_t __thread_starts_sect_end[]   __asm("section$end$__TEXT$__thread_starts");
 
+
+/*
+ * Framebuffer progress bands -- bring-up only, see the patch header.
+ *
+ * The framebuffer has to be reached three different ways over the course of
+ * the boot, so the address lives in j3_fb_addr and arm_vm_init moves it along
+ * as each mapping is retired:
+ *
+ *   1. physical, while the V=P bootstrap mapping in TTBR0 is live -- up to
+ *      the set_mmu_ttb(invalid_ttep) inside arm_vm_init;
+ *   2. phystokv(), while TTBR1 still holds the bootstrap tables built by
+ *      start.s -- up to set_mmu_ttb_alternate(cpu_ttep);
+ *   3. whatever ml_io_map() hands back, once pmap_bootstrap() has run and
+ *      virtual_space_start exists.
+ *
+ * Between (2) and (3) there is no mapping at all, which is why no band can be
+ * placed over the table switch itself.
+ *
+ * Every mapping but the last is write-back, so the pixels have to be pushed
+ * out by hand or the band never reaches the panel. The flush is harmless on
+ * the device-memory mapping from ml_io_map().
+ *
+ * Two rows of bands, so that neither group grows long enough to be miscounted
+ * from a photograph: j3_mark() draws near the bottom of the panel and
+ * j3_mark2() near the top. Nothing is static: osfmk/arm64/arm_vm_init.c marks
+ * its way through arm_vm_init() with the same helpers. Keep the geometry in
+ * step with the J3_MARK macro in osfmk/arm64/start.s.
+ */
+#define J3_FB_BASE      0x67000000UL
+#define J3_FB_STRIDE    2880UL
+#define J3_FB_HEIGHT    1280UL
+#define J3_FB_SIZE      (J3_FB_STRIDE * J3_FB_HEIGHT)
+#define J3_MARK_ROW0    950UL
+#define J3_MARK2_ROW0   700UL
+#define J3_MARK_PITCH   24UL
+#define J3_MARK_HEIGHT  16U
+#define J3_MARK_WIDTH   720U
+
+uintptr_t j3_fb_addr = (uintptr_t)J3_FB_BASE;
+
+void j3_mark(unsigned slot, uint32_t colour);
+void j3_mark2(unsigned slot, uint32_t colour);
+
+static void
+j3_band(unsigned long row0, unsigned slot, uint32_t colour)
+{
+	volatile uint32_t *band = (volatile uint32_t *)
+	    (j3_fb_addr + (row0 + slot * J3_MARK_PITCH) * J3_FB_STRIDE);
+	const unsigned npx = J3_MARK_WIDTH * J3_MARK_HEIGHT;
+
+	for (unsigned i = 0; i < npx; i++) {
+		band[i] = colour;
+	}
+	__asm__ volatile ("dsb sy");
+	for (unsigned i = 0; i < npx * 4u; i += 64u) {
+		__asm__ volatile ("dc cvac, %0" :: "r"((uintptr_t)band + i) : "memory");
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+void
+j3_mark(unsigned slot, uint32_t colour)
+{
+	j3_band(J3_MARK_ROW0, slot, colour);
+}
+
+void
+j3_mark2(unsigned slot, uint32_t colour)
+{
+	j3_band(J3_MARK2_ROW0, slot, colour);
+}
+
