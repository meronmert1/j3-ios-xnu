+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch,
+    OSObject *target, void *reference)
+{
+	char in[96];
+	char out[96];
+	uint32_t inCount;
+	uint32_t inBytes;
+	uint32_t outWanted;
+	uint32_t outBytes;
+	IOReturn ret;
+
+	if (arguments == NULL) {
+		return kIOReturnBadArgument;
+	}
+
+	/*
+	 * The inputs are read before the call because a selector is free to
+	 * overwrite the argument block, and the whole point of the line is to
+	 * say what was asked as well as what was answered.
+	 */
+	inCount = arguments->scalarInputCount;
+	inBytes = arguments->structureInputSize;
+	outWanted = arguments->scalarOutputCount;
+	outBytes = arguments->structureOutputSize;
+	iomfb_scalars(in, sizeof(in), arguments->scalarInput, inCount);
+
+	ret = handleMethod(selector, arguments, dispatch, target, reference);
+
+	if (iomfb_trace) {
+		iomfb_scalars(out, sizeof(out), arguments->scalarOutput,
+		    arguments->scalarOutputCount);
+		IOLog("IOMobileFramebuffer: [%u] selector %u in %u{%s}/%ub "
+		    "out %u->%u{%s}/%ub ret 0x%x\n",
+		    (unsigned)fSerial, (unsigned)selector,
+		    (unsigned)inCount, in, (unsigned)inBytes,
+		    (unsigned)outWanted,
+		    (unsigned)arguments->scalarOutputCount, out,
+		    (unsigned)outBytes, ret);
+	}
+
+	return ret;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::handleMethod(uint32_t selector,
+    IOExternalMethodArguments *arguments, IOExternalMethodDispatch *dispatch,
+    OSObject *target, void *reference)
+{
+	switch (selector) {
+	case kIOMFBIsMainDisplay:
+		/*
+		 * There is one display and this is it. The framework compares
+		 * this against the 1 that GetMainDisplay asked for and keeps
+		 * the first service that says yes; it also compares it against
+		 * the 0 that the display list asks for, where saying yes is
+		 * what makes this a primary display rather than an external
+		 * one.
+		 */
+		if (arguments->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		arguments->scalarOutput[0] = 1;
+		arguments->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kIOMFBGetID:
+		if (arguments->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		arguments->scalarOutput[0] = kIOMFBDisplayID;
+		arguments->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kIOMFBGetDisplaySize: {
+		/*
+		 * Two scalars, width then height: kern_GetDisplaySize loads
+		 * both at once and runs ucvtf.2d over the pair, so what the
+		 * caller ends up with is a CGSize of two doubles in that
+		 * order.
+		 *
+		 * The numbers come from the console the shim set up rather
+		 * than from constants here. It is the same framebuffer either
+		 * way and there is no second place for them to disagree.
+		 */
+		PE_Video video;
+
+		if (arguments->scalarOutputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		if (PE_current_console(&video) != 0 ||
+		    video.v_width == 0 || video.v_height == 0) {
+			return kIOReturnNotReady;
+		}
+		arguments->scalarOutput[0] = video.v_width;
+		arguments->scalarOutput[1] = video.v_height;
+		arguments->scalarOutputCount = 2;
+		return kIOReturnSuccess;
+	}
+
+	case kIOMFBGetColorRemapMode:
+		/* Nothing is remapped. */
+		if (arguments->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		arguments->scalarOutput[0] = 0;
+		arguments->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kIOMFBSetDebugFlags:
+		/* Accepted and dropped; the answer is the flags as they were. */
+		if (arguments->scalarOutputCount >= 1) {
+			arguments->scalarOutput[0] = 0;
+			arguments->scalarOutputCount = 1;
+		}
+		return kIOReturnSuccess;
+
+	case kIOMFBSetDisplayDevice:
+		/* There is one device and it is already selected. */
+		arguments->scalarOutputCount = 0;
+		return kIOReturnSuccess;
+
+	case kIOMFBVideoPowerSavings:
+		/* Nothing is saving power. Accepted and dropped. */
+		arguments->scalarOutputCount = 0;
+		return kIOReturnSuccess;
+
+	case kIOMFBNotifications: {
+		/*
+		 * kern_EnableNotifications and kern_DisableNotifications are
+		 * the same selector, told apart by the first scalar:
+		 *
+		 *     enable(ref, type, cb, ctx):
+		 *         { trampoline[type], ref, type, 0 }
+		 *     disable(ref, type):
+		 *         { 0,                0,   type, 0 }
+		 *
+		 * The first two are a function and a context in the caller's
+		 * address space. They are not called from here -- they are what
+		 * goes into the mach message a real driver sends to the port
+		 * registered for that type, where IONotificationPort's
+		 * dispatcher calls the one with the other.
+		 *
+		 * Nothing sends those messages yet, so what this does is agree
+		 * and remember. The agreeing is the part that matters today:
+		 * the framework asked twice about notifications and was
+		 * refused twice, and a refusal is not an answer a driver with
+		 * a display is supposed to give.
+		 */
+		uint64_t type;
+
+		if (arguments->scalarInputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		type = arguments->scalarInput[2];
+		if (type >= kIOMFBNotifyTypes) {
+			IOLog("IOMobileFramebuffer: [%u] notifications for "
+			    "unknown type %llu\n", (unsigned)fSerial,
+			    (unsigned long long)type);
+			return kIOReturnBadArgument;
+		}
+		if (!iomfb_notify) {
+			return kIOReturnUnsupported;
+		}
+
+		fNotifyCallback[type] = arguments->scalarInput[0];
+		fNotifyContext[type] = arguments->scalarInput[1];
+
+		IOLog("IOMobileFramebuffer: [%u] notifications %s for type "
+		    "%llu\n", (unsigned)fSerial,
+		    fNotifyCallback[type] ? "on" : "off",
+		    (unsigned long long)type);
+
+		arguments->scalarOutputCount = 0;
+		return kIOReturnSuccess;
+	}
+
+	case kIOMFBChangeFrameInfo:
+		/*
+		 * kern_ChangeFrameInfo(ref, mask) sends { 3, mask }: the 3 is
+		 * the frame-info notification type, hard coded in the
+		 * framework, and the mask says which of the fields the caller
+		 * wants collected. QuartzCore builds that mask out of the
+		 * names it recognised in the list SupportedFrameInfo returned,
+		 * and it recognises none of ours, so the mask is 0 and there
+		 * is nothing here to turn on.
+		 *
+		 * Accepted and dropped, like the other setters.
+		 */
+		arguments->scalarOutputCount = 0;
+		return kIOReturnSuccess;
+
+	case kIOMFBSupportedFrameInfo: {
+		/*
+		 * One field, named so that nothing matches it -- and the whole
+		 * display depends on there being one.
+		 *
+		 * The call itself is, from _InfoKeyInitialize in the
+		 * framework: the scalar in is an index, the scalar out is the
+		 * total number of fields, and the 64 bytes are that field's
+		 * name as a C string.
+		 *
+		 *     SupportedFrameInfo(ref, 0, &count, buf);
+		 *     if (ret != 0 && count == 0) give up;
+		 *     names = calloc(count + 1, 8);
+		 *     names[0] = strndup(buf, 64);
+		 *     for (i = 1; i < count; i++) {
+		 *             SupportedFrameInfo(ref, i, &count, buf);
+		 *             names[i] = strndup(buf, 64);
+		 *     }
+		 *
+		 * This used to answer none, on the reasoning that QuartzCore's
+		 * test on the returned array -- cbz x0, 0x18530d650 -- merely
+		 * skips frame-info collection and carries on. The trace says
+		 * otherwise. What that branch skips is:
+		 *
+		 *     if (!names) goto no_frame_info;
+		 *     src = IOMobileFramebufferGetRunLoopSource(ref, 3);
+		 *     if (!src) goto no_frame_info;
+		 *     add_runloop_source(this, src, true);
+		 *     IOMobileFramebufferFrameInfo(ref, callback, this, 1, 0);
+		 *
+		 * and add_runloop_source is not what its name suggests:
+		 *
+		 *     slot = b ? 0x118 : 0x110;
+		 *     if (!this->[slot])
+		 *             this->[slot] = x_thread_create(thread_body, this);
+		 *     while (!this->[b ? 0x198 : 0x190])
+		 *             pthread_cond_wait(...);
+		 *     CFRunLoopAddSource(rl, src, kCFRunLoopDefaultMode);
+		 *
+		 * It starts the IOMFBServer's own thread and waits for it to
+		 * publish its run loop. The only other call to it is in the
+		 * branch taken when the display's flags have 0x300 set, which
+		 * is the external-display case and not this one. So on a
+		 * handset this call is the only thing that ever starts that
+		 * thread, and answering none left the window server holding a
+		 * display whose server had never run.
+		 *
+		 * The evidence was the absence of a line rather than a line:
+		 * GetRunLoopSource ends up in _kern_GetRunLoopSource, which
+		 * calls IOConnectSetNotificationPort, and this driver now logs
+		 * registerNotificationPort. Nothing was logged, and nothing at
+		 * all reached this driver after selector 74 -- which is where
+		 * that branch is.
+		 *
+		 * So: one field. The name is deliberately none of the five
+		 * QuartzCore looks for, because the loop that follows calls
+		 * ChangeFrameInfo only for names it recognises and passes over
+		 * the rest in silence. That gets the array past the test
+		 * without claiming a field this driver has no value for.
+		 * iomfbframeinfo=0 restores the old answer for comparison.
+		 */
+		uint64_t index;
+
+		index = (arguments->scalarInputCount >= 1) ?
+		    arguments->scalarInput[0] : 0;
+
+		if (arguments->scalarOutputCount >= 1) {
+			arguments->scalarOutput[0] = iomfb_frameinfo ? 1 : 0;
+			arguments->scalarOutputCount = 1;
+		}
+		if (arguments->structureOutput != NULL &&
+		    arguments->structureOutputSize > 0) {
+			bzero(arguments->structureOutput,
+			    arguments->structureOutputSize);
+			if (iomfb_frameinfo && index == 0 &&
+			    arguments->structureOutputSize >=
+			    sizeof(kIOMFBFrameInfoName)) {
+				memcpy(arguments->structureOutput,
+				    kIOMFBFrameInfoName,
+				    sizeof(kIOMFBFrameInfoName));
+			}
+		}
+		return kIOReturnSuccess;
+	}
+
+	default:
+		break;
+	}
+
+	/*
+	 * Everything else is decided by its shape rather than by its number.
+	 *
+	 * A selector that asks for nothing back -- no scalars, no structure --
+	 * cannot be a question. It is the caller setting something, and the
+	 * only two answers available are "done" and "this driver is broken".
+	 * Refusing is the second one, and it is the wrong one: there is no
+	 * hardware here to configure, so the setting is already as true as it
+	 * will ever be, and the caller has nothing to do differently.
+	 *
+	 * This was learned one boot at a time. Selector 74 was answered,
+	 * which uncovered 72; 72 was answered, which uncovered 73; and 73 is
+	 * kern_ChangeFrameInfo turning on frame-info fields that do not
+	 * exist. All three are the same kind of call, and each cost a build,
+	 * a flash and a boot to find. The rest of that kind are answered here
+	 * without being named first.
+	 *
+	 * A selector that does want something back is a different matter and
+	 * still gets a refusal. Inventing a number for a caller that asked
+	 * for one is worse than failing in front of it: a zero width, a zero
+	 * surface or a zero timestamp is a wrong answer that travels, while a
+	 * refusal stops where it happens and prints its own number.
+	 *
+	 * iomfbaccept=0 goes back to refusing both kinds.
+	 */
+	if (iomfb_accept && arguments->scalarOutputCount == 0 &&
+	    arguments->structureOutputSize == 0) {
+		IOLog("IOMobileFramebuffer: [%u] selector %u accepted and "
+		    "dropped (nothing asked for)\n",
+		    (unsigned)fSerial, (unsigned)selector);
+		return kIOReturnSuccess;
+	}
+
+	IOLog("IOMobileFramebuffer: [%u] unimplemented selector %u\n",
+	    (unsigned)fSerial, (unsigned)selector);
+
+	return super::externalMethod(selector, arguments, dispatch, target,
+	           reference);
+}
