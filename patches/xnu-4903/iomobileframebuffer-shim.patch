+++ b/iokit/Kernel/IOMobileFramebufferShim.cpp
@@ -0,0 +1,616 @@
+/*
+ * IOMobileFramebufferShim.cpp -- enough of IOMobileFramebuffer that iOS
+ * believes this handset has a display.
+ *
+ * backboardd dies on every boot with
+ *
+ *     Assertion failed: No window server display found
+ *     backboarddaemon-195.65.1/megatrond/BKDisplay.m:417
+ *
+ * from BKDisplayStartWindowServer(), and SpringBoard follows it down because
+ * FrontBoard cannot reach a backboardd that is not there. The assertion is
+ * the tail of this:
+ *
+ *     CADisplay *main = [CADisplay mainDisplay];
+ *     id dispId       = [main displayId];
+ *     id disp         = [server displayWithDisplayId:dispId];
+ *     if (disp == nil) <assert>
+ *
+ * and +[CADisplay mainDisplay] goes through IOMobileFramebuffer.framework,
+ * which does exactly three things that matter here. From
+ * _IOMobileFramebufferGetDisplay:
+ *
+ *     IOServiceGetMatchingServices(port, IOServiceMatching("IOMobileFramebuffer"), &it);
+ *     while ((service = IOIteratorNext(it))) {
+ *             if (service is AppleWirelessDisplay or AppleADBE1) continue;
+ *             if (IOMobileFramebufferOpen(service, mach_task_self(), 0, &ref)) continue;
+ *             if (IOMobileFramebufferIsMainDisplay(ref, &isMain)) continue;
+ *             if (isMain == wanted) return ref;
+ *     }
+ *
+ * IOMobileFramebufferOpen is IOServiceOpen with user client type 0, and
+ * IsMainDisplay is one call:
+ *
+ *     IOConnectCallScalarMethod(connect, 18, NULL, 0, &out, &outCount);
+ *     isMain = (out == 1);
+ *
+ * So the whole contract for being found is: a registered IOService of class
+ * IOMobileFramebuffer, a user client for type 0, and selector 18 answering
+ * one scalar. That is what this file is, and no more. There is no
+ * framebuffer behind it yet -- the pixels this kernel prints to are the ones
+ * the shim set up at boot and nothing here touches them.
+ *
+ * What the whole chain above the framework turned out to be, read out of
+ * QuartzCore, because everything this file answers is answered for its
+ * benefit:
+ *
+ *     -[CAWindowServer _detectDisplays]
+ *       for each of three kinds -- CLCD, RGBOut, Wireless:
+ *         count = display_count_of_type(kind)
+ *         for i in 0..count:
+ *           d = create_display_of_type(kind, i, block)   -- the AppleDisplay
+ *           s = d->new_server()                          -- the EAGLServer
+ *           [self addDisplay:[[CAWindowServerDisplay alloc]
+ *                             _initWithCADisplayServer:s]]
+ *
+ *     display_count_of_type(kind):
+ *       list = IOMobileFramebufferCreateDisplayList()
+ *       count entries whose info->type == kind
+ *
+ * and the display list is built by _iomfb_populate_display_infos, which
+ * walks the same IOMobileFramebuffer services and decides each one's type
+ * like this:
+ *
+ *     if (no "AppleTV" property)                    -- a handset, so: us
+ *             GetDisplay(&p, 0, 0)                  -- "the display that is
+ *                                                       NOT the main one"
+ *             type = (p != NULL && p->service == this) ? 1 : 0
+ *
+ * That call is meant to fail on a handset: there is one framebuffer, it is
+ * the main display, and nothing matches "not main". type is therefore 0,
+ * the name is "primary", and CLCD is the kind that finds it. Answering
+ * selector 18 with 1 is what makes that come out right, and answering it
+ * with 0 would make this display count as an external one and leave
+ * CAWindowServer with nothing.
+ *
+ * Which is to say: everything from the service down to addDisplay: is
+ * accounted for, and none of it can refuse us on the evidence read so far.
+ * The names line up too -- the server is called "LCD" (AppleCLCDDisplay
+ * passes false for the TVOut flag) and +[CADisplay mainDisplay] is the
+ * display whose name is exactly that. So this boot is not about adding an
+ * answer; it is about seeing the conversation, because the remaining
+ * candidates differ only in what values cross the boundary and in which
+ * order:
+ *
+ *   - a selector answered with something the framework rejects quietly,
+ *   - an entry point that is not externalMethod at all, which until now
+ *     logged nothing: IOConnectSetNotificationPort is used twice by the
+ *     framework and IOUserClient refuses it by default,
+ *   - or the display being built correctly and _CASGetDisplays -- the mach
+ *     call CADisplay makes back to the window server -- returning nothing,
+ *     in which case nothing here is at fault and the hunt moves into
+ *     backboardd.
+ *
+ * So every call is now traced with its arguments and its answers, every
+ * client is numbered so that the probe opens can be told apart from the one
+ * the window server keeps, and the entry points that used to be silent
+ * announce themselves. Boot with iomfbtrace=0 to have none of it.
+ */
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>          /* proc_selfpid, to name who opened a client */
+
+/*
+ * The selectors, named from the framework's own callers. Each was found by
+ * running with none of them implemented and reading the numbers the console
+ * printed back, then looking for the IOConnectCallScalarMethod that passes
+ * that number:
+ *
+ *      7   kern_GetID              out 1
+ *      8   kern_GetDisplaySize     out 2
+ *     15   kern_SetDebugFlags      in 2, out 1
+ *     18   kern_IsMainDisplay      out 1
+ *     22   kern_SetDisplayDevice   in 1
+ *     33   kern_EnableDisableVideoPowerSavings   in 1
+ *     57   kern_GetColorRemapMode  out 1
+ *     74   kern_SupportedFrameInfo in 1, out 1 + 64 bytes
+ */
+#define kIOMFBGetID             7
+#define kIOMFBGetDisplaySize    8
+#define kIOMFBSetDebugFlags     15
+#define kIOMFBIsMainDisplay     18
+#define kIOMFBSetDisplayDevice  22
+#define kIOMFBVideoPowerSavings 33
+#define kIOMFBGetColorRemapMode 57
+#define kIOMFBSupportedFrameInfo 74
+
+/*
+ * The one display. This is what GetID answers. It is not the number the
+ * window server matches on -- that one is a counter inside QuartzCore,
+ * handed out when the CAWindowServerDisplay is built and carried back to
+ * CADisplay in the kCADisplayId field of the display list -- so the value
+ * matters only in being non-zero and stable.
+ */
+#define kIOMFBDisplayID         1
+
+/* Boot-arg iomfbtrace, on unless it is turned off. */
+static int iomfb_trace = 1;
+
+/* One number per user client, so the probes can be told from the keeper. */
+static volatile SInt32 iomfb_client_count;
+
+class IOMobileFramebuffer : public IOService
+{
+	OSDeclareDefaultStructors(IOMobileFramebuffer);
+
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID,
+	    UInt32 type, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+class IOMobileFramebufferUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
+
+	IOMobileFramebuffer      *fOwner;
+	task_t                    fTask;
+	uint32_t                  fSerial;
+
+	IOReturn handleMethod(uint32_t selector,
+	    IOExternalMethodArguments *arguments,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID,
+	    UInt32 type) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientDied(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector,
+	    IOExternalMethodArguments *arguments,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+
+	/*
+	 * The quiet ones. None of these was reachable through externalMethod
+	 * and so none of them has ever printed anything, while the framework
+	 * calls IOConnectSetNotificationPort twice -- for the vsync run loop
+	 * source and for hot plug detect -- and IOUserClient answers it with
+	 * kIOReturnUnsupported. Whether that matters is exactly the sort of
+	 * thing that has to be seen rather than assumed, so they all say so
+	 * and then do what they did before.
+	 */
+	virtual IOReturn registerNotificationPort(mach_port_t port,
+	    UInt32 type, UInt32 refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn getNotificationSemaphore(UInt32 notification_type,
+	    semaphore_t *semaphore) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type,
+	    IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn connectClient(IOUserClient *client) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOExternalMethod *getTargetAndMethodForIndex(
+		IOService **targetP, UInt32 index) APPLE_KEXT_OVERRIDE;
+	virtual IOExternalAsyncMethod *getAsyncTargetAndMethodForIndex(
+		IOService **targetP, UInt32 index) APPLE_KEXT_OVERRIDE;
+};
+
+/*
+ * Up to eight scalars of a call, comma separated, into a caller's buffer.
+ * Eight because IOExternalMethodArguments carries sixteen and no selector
+ * the framework uses passes more than a few; a line that runs off the right
+ * of a 720 pixel console is worse than a truncated one.
+ */
+static void
+iomfb_scalars(char *buf, size_t len, const uint64_t *v, uint32_t n)
+{
+	size_t off = 0;
+	uint32_t i;
+
+	if (len == 0) {
+		return;
+	}
+	buf[0] = '\0';
+	if (v == NULL) {
+		return;
+	}
+	for (i = 0; i < n && i < 8; i++) {
+		int wrote;
+
+		if (off + 1 >= len) {
+			break;
+		}
+		wrote = snprintf(buf + off, len - off, "%s%llu",
+		    i ? "," : "", (unsigned long long)v[i]);
+		/*
+		 * snprintf returns what it would have written, which on
+		 * truncation is more than it did. Taking that at face value
+		 * would wrap len - off on the next pass, so the loop stops at
+		 * the truncation instead.
+		 */
+		if (wrote < 0 || (size_t)wrote >= len - off) {
+			break;
+		}
+		off += (size_t)wrote;
+	}
+}
+
+#define super IOService
+OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
+
+bool
+IOMobileFramebuffer::start(IOService *provider)
+{
+	uint32_t on = 1;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+
+	if (PE_parse_boot_argn("iomfbtrace", &on, sizeof(on))) {
+		iomfb_trace = (int)on;
+	}
+
+	/*
+	 * Matched from gIOKernelConfigTables against IOResources, so there is
+	 * no kext and no Info.plist; registerService() is what puts it where
+	 * IOServiceGetMatchingServices can find it.
+	 */
+	registerService();
+
+	IOLog("IOMobileFramebuffer: registered (trace %s)\n",
+	    iomfb_trace ? "on" : "off");
+	return true;
+}
+
+IOReturn
+IOMobileFramebuffer::newUserClient(task_t owningTask, void *securityID,
+    UInt32 type, IOUserClient **handler)
+{
+	IOMobileFramebufferUserClient *client;
+
+	/*
+	 * Type 0 is the only one the framework asks for. Anything else is
+	 * refused rather than quietly answered, so that a second kind of
+	 * client shows up as a refusal instead of as wrong behaviour.
+	 */
+	if (type != 0) {
+		IOLog("IOMobileFramebuffer: refusing user client type %u\n",
+		    (unsigned)type);
+		return kIOReturnBadArgument;
+	}
+
+	client = OSTypeAlloc(IOMobileFramebufferUserClient);
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+
+	if (!client->initWithTask(owningTask, securityID, type)) {
+		client->release();
+		return kIOReturnBadArgument;
+	}
+
+	if (!client->attach(this) || !client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnNotAttached;
+	}
+
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+#undef super
+#define super IOUserClient
+OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask,
+    void *securityID, UInt32 type)
+{
+	if (!super::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fOwner = NULL;
+
+	/*
+	 * Numbered from one on the way in rather than on the way out, so that
+	 * a client which fails to start still consumes its number and the gap
+	 * is visible.
+	 *
+	 * The framework opens one of these per service per probe and closes it
+	 * again when the answer is no, and the window server keeps exactly one
+	 * open for the display it built. Which client a call belongs to is
+	 * therefore the difference between "something looked at us" and
+	 * "something is using us", and a console full of unnumbered lines
+	 * cannot tell them apart.
+	 */
+	fSerial = (uint32_t)OSIncrementAtomic(&iomfb_client_count) + 1;
+
+	IOLog("IOMobileFramebuffer: [%u] opened by pid %d\n",
+	    (unsigned)fSerial, proc_selfpid());
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fOwner = OSDynamicCast(IOMobileFramebuffer, provider);
+	if (fOwner == NULL) {
+		return false;
+	}
+	return super::start(provider);
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	IOLog("IOMobileFramebuffer: [%u] closed\n", (unsigned)fSerial);
+
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
